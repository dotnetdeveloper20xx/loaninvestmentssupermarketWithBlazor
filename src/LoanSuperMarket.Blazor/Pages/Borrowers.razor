@page "/borrowers"
@inject BorrowersApiClient BorrowersApiClient

<PageHeader Title="Borrowers"
            Subtitle="Manage borrower profiles, verification status and onboarding records.">
    <ActionContent>
        <button class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-700"
                @onclick="OpenCreateModal">
            + New Borrower
        </button>
    </ActionContent>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="mb-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
        @_errorMessage
    </div>
}

<DataGridToolbar State="_gridState"
                 SearchLabel="Search borrowers"
                 SearchPlaceholder="Search by name, email or phone..."
                 VisibleCount="PagedBorrowers.Count"
                 TotalCount="_borrowers.Count"
                 StatusOptions="_statusOptions"
                 OnStateChanged="HandleGridStateChanged" />

<AppDataTable Title="Borrower Management"
              Subtitle="Operational borrower list for onboarding and verification workflows."
              IsLoading="_isLoading"
              IsEmpty="@(!_isLoading && FilteredBorrowers.Count == 0)"
              LoadingText="Loading borrowers..."
              EmptyIcon="👤"
              EmptyTitle="No borrowers found"
              EmptyMessage="No borrowers match the current search or filter criteria.">

    <HeaderActions>
        <button class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50"
                @onclick="LoadBorrowersAsync">
            Refresh
        </button>
    </HeaderActions>

    <EmptyActions>
        @if (_borrowers.Count == 0)
        {
            <button class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-700"
                    @onclick="OpenCreateModal">
                Create Borrower
            </button>
        }
        else
        {
            <button class="rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50"
                    @onclick="ClearFilters">
                Clear Filters
            </button>
        }
    </EmptyActions>

    <HeaderTemplate>
        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
            <DataGridColumnHeader State="_gridState"
                                  Column="FullName"
                                  Title="Borrower"
                                  OnSortChanged="HandleGridStateChanged" />
        </th>

        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
            <DataGridColumnHeader State="_gridState"
                                  Column="Email"
                                  Title="Contact"
                                  OnSortChanged="HandleGridStateChanged" />
        </th>

        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
            <DataGridColumnHeader State="_gridState"
                                  Column="DateOfBirth"
                                  Title="Date of Birth"
                                  OnSortChanged="HandleGridStateChanged" />
        </th>

        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
            <DataGridColumnHeader State="_gridState"
                                  Column="Status"
                                  Title="Status"
                                  OnSortChanged="HandleGridStateChanged" />
        </th>

        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
            <DataGridColumnHeader State="_gridState"
                                  Column="CreatedAtUtc"
                                  Title="Created"
                                  OnSortChanged="HandleGridStateChanged" />
        </th>
    </HeaderTemplate>

    <RowTemplate>
        @foreach (var borrower in PagedBorrowers)
        {
            <tr class="hover:bg-slate-50">
                <td class="px-6 py-4">
                    <div class="font-semibold text-slate-900">@borrower.FullName</div>
                    <div class="mt-1 text-xs text-slate-500">@borrower.Id</div>
                </td>

                <td class="px-6 py-4">
                    <div class="text-sm font-medium text-slate-900">@borrower.Email</div>
                    <div class="mt-1 text-sm text-slate-500">@borrower.PhoneNumber</div>
                </td>

                <td class="px-6 py-4 text-sm text-slate-700">
                    @borrower.DateOfBirth.ToString("dd MMM yyyy")
                </td>

                <td class="px-6 py-4">
                    <StatusBadge Status="@borrower.Status" />
                </td>

                <td class="px-6 py-4 text-sm text-slate-500">
                    @borrower.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")
                </td>
            </tr>
        }
    </RowTemplate>
</AppDataTable>

<DataGridPager State="_gridState"
               TotalCount="FilteredBorrowers.Count"
               OnPageChanged="HandleGridStateChanged" />

<CreateBorrowerModal IsOpen="_isCreateModalOpen"
                     OnClose="CloseCreateModal"
                     OnCreated="HandleBorrowerCreated" />

@code {
    private readonly GridState _gridState = new();

    private readonly IReadOnlyList<DataGridToolbar.DataGridStatusOption> _statusOptions =
    [
        new("PendingVerification", "Pending Verification"),
        new("Verified", "Verified"),
        new("Suspended", "Suspended"),
        new("Archived", "Archived")
    ];

    private List<BorrowerDto> _borrowers = [];
    private bool _isLoading = true;
    private bool _isCreateModalOpen;
    private string? _errorMessage;

    private List<BorrowerDto> FilteredBorrowers
    {
        get
        {
            var query = _borrowers.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_gridState.SearchText))
            {
                query = query.Where(borrower =>
                    borrower.FullName.Contains(_gridState.SearchText, StringComparison.OrdinalIgnoreCase)
                    || borrower.Email.Contains(_gridState.SearchText, StringComparison.OrdinalIgnoreCase)
                    || borrower.PhoneNumber.Contains(_gridState.SearchText, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_gridState.SelectedStatus))
            {
                query = query.Where(borrower =>
                    borrower.Status.Equals(_gridState.SelectedStatus, StringComparison.OrdinalIgnoreCase));
            }

            query = (_gridState.SortColumn, _gridState.SortAscending) switch
            {
                ("FullName", true) => query.OrderBy(borrower => borrower.FullName),
                ("FullName", false) => query.OrderByDescending(borrower => borrower.FullName),

                ("Email", true) => query.OrderBy(borrower => borrower.Email),
                ("Email", false) => query.OrderByDescending(borrower => borrower.Email),

                ("DateOfBirth", true) => query.OrderBy(borrower => borrower.DateOfBirth),
                ("DateOfBirth", false) => query.OrderByDescending(borrower => borrower.DateOfBirth),

                ("Status", true) => query.OrderBy(borrower => borrower.Status),
                ("Status", false) => query.OrderByDescending(borrower => borrower.Status),

                ("CreatedAtUtc", true) => query.OrderBy(borrower => borrower.CreatedAtUtc),
                ("CreatedAtUtc", false) => query.OrderByDescending(borrower => borrower.CreatedAtUtc),

                _ => query.OrderByDescending(borrower => borrower.CreatedAtUtc)
            };

            return query.ToList();
        }
    }

    private List<BorrowerDto> PagedBorrowers =>
        FilteredBorrowers
            .Skip((_gridState.PageNumber - 1) * _gridState.PageSize)
            .Take(_gridState.PageSize)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadBorrowersAsync();
    }

    private async Task LoadBorrowersAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await BorrowersApiClient.GetBorrowersAsync();

            if (response is null)
            {
                _errorMessage = "No response received from the API.";
                return;
            }

            if (!response.Success)
            {
                _errorMessage = response.Errors.Count > 0
                    ? string.Join(", ", response.Errors)
                    : "Failed to load borrowers.";

                return;
            }

            _borrowers = response.Data?.ToList() ?? [];
        }
        catch (Exception exception)
        {
            _errorMessage = $"Unable to load borrowers. {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task HandleGridStateChanged()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void OpenCreateModal()
    {
        _isCreateModalOpen = true;
    }

    private void CloseCreateModal()
    {
        _isCreateModalOpen = false;
    }

    private async Task HandleBorrowerCreated()
    {
        await LoadBorrowersAsync();
    }

    private void ClearFilters()
    {
        _gridState.ClearFilters();
    }
}