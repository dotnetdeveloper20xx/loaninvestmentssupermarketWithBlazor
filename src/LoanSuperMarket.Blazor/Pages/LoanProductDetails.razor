@page "/loan-products/{Id:guid}"
@inject LoanProductsApiClient LoanProductsApiClient
@inject NavigationManager NavigationManager

<PageHeader Title="Loan Product Details"
            Subtitle="Review product configuration, marketplace status and lending criteria.">
    <ActionContent>
        <button class="rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50"
                @onclick="GoBack">
            ← Back to Products
        </button>
    </ActionContent>
</PageHeader>

@if (_isLoading)
{
    <AppCard>
        <div class="flex min-h-64 items-center justify-center">
            <div class="text-center">
                <div class="mx-auto h-10 w-10 animate-spin rounded-full border-4 border-blue-100 border-t-blue-600"></div>
                <p class="mt-4 text-sm text-slate-500">
                    Loading loan product...
                </p>
            </div>
        </div>
    </AppCard>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="rounded-2xl border border-red-200 bg-red-50 p-5 text-sm text-red-700">
        @_errorMessage
    </div>
}
else if (_loanProduct is not null)
{
    <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">
        <div class="xl:col-span-2">
            <AppCard>
                <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                        <div class="flex items-center gap-3">
                            <h2 class="text-2xl font-bold text-slate-900">
                                @_loanProduct.Title
                            </h2>

                            <StatusBadge Status="@_loanProduct.Status" />
                        </div>

                        <p class="mt-4 text-sm leading-6 text-slate-600">
                            @_loanProduct.Description
                        </p>
                    </div>
                </div>

                <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
                    <InfoTile Label="Minimum Amount"
                              Value="@($"£{_loanProduct.MinimumAmount:N0}")"
                              Icon="⬇️" />

                    <InfoTile Label="Maximum Amount"
                              Value="@($"£{_loanProduct.MaximumAmount:N0}")"
                              Icon="⬆️" />

                    <InfoTile Label="Interest Rate"
                              Value="@($"{_loanProduct.InterestRate:N2}%")"
                              Icon="📈" />

                    <InfoTile Label="Loan Term"
                              Value="@($"{_loanProduct.MinimumTermMonths} - {_loanProduct.MaximumTermMonths} months")"
                              Icon="📅" />
                </div>
            </AppCard>

            <div class="mt-6">
                <AppCard Title="Operational Notes"
                         Subtitle="Future workflow actions will appear here.">
                    <div class="space-y-4 text-sm text-slate-600">
                        <p>
                            This section is designed for future enterprise workflow actions such as approval,
                            publishing, archiving, risk review and audit history.
                        </p>

                        <div class="rounded-2xl border border-blue-100 bg-blue-50 p-4 text-blue-700">
                            This product currently exists as a marketplace product record. Later, admin users will be able
                            to move it through approval and publishing workflows.
                        </div>
                    </div>
                </AppCard>
            </div>
        </div>

        <div class="space-y-6">
            <AppCard Title="Product Summary"
                     Subtitle="Key operational metadata">
                <dl class="space-y-4 text-sm">
                    <div>
                        <dt class="font-medium text-slate-500">Product ID</dt>
                        <dd class="mt-1 break-all font-mono text-xs text-slate-800">
                            @_loanProduct.Id
                        </dd>
                    </div>

                    <div>
                        <dt class="font-medium text-slate-500">Lender ID</dt>
                        <dd class="mt-1 break-all font-mono text-xs text-slate-800">
                            @_loanProduct.LenderId
                        </dd>
                    </div>

                    <div>
                        <dt class="font-medium text-slate-500">Currency</dt>
                        <dd class="mt-1 text-slate-800">
                            @_loanProduct.Currency
                        </dd>
                    </div>

                    <div>
                        <dt class="font-medium text-slate-500">Created</dt>
                        <dd class="mt-1 text-slate-800">
                            @_loanProduct.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                        </dd>
                    </div>
                </dl>
            </AppCard>

            <AppCard Title="Workflow Actions"
                     Subtitle="Operational controls for product lifecycle">

                @if (!string.IsNullOrWhiteSpace(_workflowMessage))
                {
                    <div class="mb-4 rounded-xl border border-green-200 bg-green-50 p-3 text-sm text-green-700">
                        @_workflowMessage
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_workflowError))
                {
                    <div class="mb-4 rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-700">
                        @_workflowError
                    </div>
                }

                <div class="space-y-3">

                    <button class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 disabled:opacity-60"
                            @onclick="SubmitForApprovalAsync"
                            disabled="@(_isSubmittingForApproval || _loanProduct.Status != "Draft")">

                        @if (_isSubmittingForApproval)
                        {
                            <span class="h-4 w-4 animate-spin rounded-full border-2 border-blue-200 border-t-white"></span>
                            <span>Submitting...</span>
                        }
                        else
                        {
                            <span>Submit for Approval</span>
                        }
                    </button>

                    <button class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-semibold text-green-700 hover:bg-green-100 disabled:opacity-60"
                            @onclick="ApproveAsync"
                            disabled="@(_isApproving || _loanProduct.Status != "PendingApproval")">
                        @if (_isApproving)
                        {
                            <span class="h-4 w-4 animate-spin rounded-full border-2 border-green-200 border-t-green-700"></span>
                            <span>Approving...</span>
                        }
                        else
                        {
                            <span>Approve Product</span>
                        }
                    </button>

                    <button class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50">
                        Publish Product
                    </button>

                    <button class="w-full rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700 hover:bg-red-100">
                        Archive Product
                    </button>
                </div>
            </AppCard>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private LoanProductDto? _loanProduct;

    private bool _isLoading = true;

    private bool _isSubmittingForApproval;

    private string? _errorMessage;

    private string? _workflowMessage;

    private string? _workflowError;

    private bool _isApproving;

    protected override async Task OnParametersSetAsync()
    {
        await LoadLoanProductAsync();
    }

    private async Task LoadLoanProductAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await LoanProductsApiClient.GetLoanProductByIdAsync(Id);

            if (response is null)
            {
                _errorMessage = "No response received from the API.";
                return;
            }

            if (!response.Success)
            {
                _errorMessage = response.Errors.Count > 0
                    ? string.Join(", ", response.Errors)
                    : "Failed to load loan product.";

                return;
            }

            _loanProduct = response.Data;
        }
        catch (Exception exception)
        {
            _errorMessage = $"Unable to load loan product. {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SubmitForApprovalAsync()
    {
        if (_loanProduct is null)
        {
            return;
        }

        _isSubmittingForApproval = true;
        _workflowMessage = null;
        _workflowError = null;

        try
        {
            var response = await LoanProductsApiClient.SubmitForApprovalAsync(_loanProduct.Id);

            if (response is null)
            {
                _workflowError = "No response received from the API.";
                return;
            }

            if (!response.Success)
            {
                _workflowError = response.Errors.Count > 0
                    ? string.Join(", ", response.Errors)
                    : "Failed to submit loan product for approval.";

                return;
            }

            _workflowMessage = response.Message
                               ?? response.Data
                               ?? "Loan product submitted for approval.";

            await LoadLoanProductAsync();
        }
        catch (Exception exception)
        {
            _workflowError = $"Unable to submit loan product for approval. {exception.Message}";
        }
        finally
        {
            _isSubmittingForApproval = false;
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/loan-products");
    }

    private async Task ApproveAsync()
    {
        if (_loanProduct is null)
        {
            return;
        }

        _isApproving = true;
        _workflowMessage = null;
        _workflowError = null;

        try
        {
            var response = await LoanProductsApiClient.ApproveAsync(_loanProduct.Id);

            if (response is null)
            {
                _workflowError = "No response received from the API.";
                return;
            }

            if (!response.Success)
            {
                _workflowError = response.Errors.Count > 0
                    ? string.Join(", ", response.Errors)
                    : "Failed to approve loan product.";

                return;
            }

            _workflowMessage = response.Message
                               ?? response.Data
                               ?? "Loan product approved.";

            await LoadLoanProductAsync();
        }
        catch (Exception exception)
        {
            _workflowError = $"Unable to approve loan product. {exception.Message}";
        }
        finally
        {
            _isApproving = false;
        }
    }
}