@page "/review-queue"
@using LoanSuperMarket.Blazor.Services.ApiClients
@using LoanSuperMarket.Shared.LoanApplications
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,CrmManager")]
@inject ReviewQueueApiClient ReviewQueueApi
@inject NavigationManager NavigationManager

<div class="max-w-6xl mx-auto">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-slate-900">Review Queue</h1>
        <p class="text-sm text-slate-500 mt-1">Manage and review submitted loan applications.</p>
    </div>

    @* Filters *@
    <div class="flex items-center gap-3 mb-4">
        <select @bind="_statusFilter"
                @bind:after="LoadQueueAsync"
                class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none">
            <option value="">All Statuses</option>
            <option value="1">Submitted</option>
            <option value="2">Under Review</option>
            <option value="8">Documents Requested</option>
        </select>

        <select @bind="_sortBy"
                @bind:after="LoadQueueAsync"
                class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none">
            <option value="">Sort by Date</option>
            <option value="amount">Sort by Amount</option>
            <option value="status">Sort by Status</option>
        </select>
    </div>

    @if (_isLoading)
    {
        <div class="flex items-center justify-center py-16">
            <div class="text-sm text-slate-500">Loading review queue...</div>
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="rounded-lg bg-red-50 border border-red-200 p-4 text-sm text-red-700">
            @_error
        </div>
    }
    else if (_items is null || _items.Count == 0)
    {
        <div class="rounded-2xl bg-white border border-slate-200 p-12 text-center">
            <div class="text-4xl mb-3">📭</div>
            <h3 class="text-lg font-semibold text-slate-700">No applications to review</h3>
            <p class="text-sm text-slate-500 mt-1">All caught up! Check back later for new submissions.</p>
        </div>
    }
    else
    {
        <div class="rounded-xl bg-white border border-slate-200 overflow-hidden">
            <table class="w-full text-sm">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="text-left px-4 py-3 font-medium text-slate-600">Borrower</th>
                        <th class="text-left px-4 py-3 font-medium text-slate-600">Product</th>
                        <th class="text-right px-4 py-3 font-medium text-slate-600">Amount</th>
                        <th class="text-left px-4 py-3 font-medium text-slate-600">Submitted</th>
                        <th class="text-left px-4 py-3 font-medium text-slate-600">Status</th>
                        <th class="text-center px-4 py-3 font-medium text-slate-600">Docs</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var item in _items)
                    {
                        <tr class="hover:bg-slate-50 cursor-pointer transition"
                            @onclick="() => NavigateToDetail(item.ApplicationId)">
                            <td class="px-4 py-3 font-medium text-slate-800">@item.BorrowerName</td>
                            <td class="px-4 py-3 text-slate-600">@item.ProductTitle</td>
                            <td class="px-4 py-3 text-right text-slate-800">@item.RequestedAmount.ToString("N2")</td>
                            <td class="px-4 py-3 text-slate-500">@item.SubmittedAtUtc.ToString("MMM dd, yyyy")</td>
                            <td class="px-4 py-3">
                                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium @GetStatusBadgeClass(item.Status)">
                                    @GetStatusLabel(item.Status)
                                </span>
                            </td>
                            <td class="px-4 py-3 text-center text-slate-600">
                                @item.VerifiedDocumentCount / @item.DocumentCount
                            </td>
                            <td class="px-4 py-3 text-right">
                                <span class="text-blue-600 text-xs font-medium">View →</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IReadOnlyList<ReviewQueueItemDto>? _items;
    private bool _isLoading = true;
    private string? _error;
    private string _statusFilter = string.Empty;
    private string _sortBy = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadQueueAsync();
    }

    private async Task LoadQueueAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            int? statusFilter = string.IsNullOrEmpty(_statusFilter) ? null : int.Parse(_statusFilter);
            string? sortBy = string.IsNullOrEmpty(_sortBy) ? null : _sortBy;

            var result = await ReviewQueueApi.GetQueueAsync(statusFilter, sortBy);
            if (result is not null && result.Success)
            {
                _items = result.Data;
            }
            else
            {
                _error = result?.Errors.FirstOrDefault() ?? "Failed to load review queue.";
            }
        }
        catch (Exception ex)
        {
            _error = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void NavigateToDetail(Guid applicationId)
    {
        NavigationManager.NavigateTo($"/review-queue/{applicationId}");
    }

    private static string GetStatusLabel(int status) => status switch
    {
        1 => "Submitted",
        2 => "Under Review",
        8 => "Documents Requested",
        _ => "Unknown"
    };

    private static string GetStatusBadgeClass(int status) => status switch
    {
        1 => "bg-blue-100 text-blue-700",
        2 => "bg-purple-100 text-purple-700",
        8 => "bg-amber-100 text-amber-700",
        _ => "bg-slate-100 text-slate-600"
    };
}
