@page "/"
@inject DashboardApiClient DashboardApiClient

<PageHeader Title="Enterprise Dashboard"
            Subtitle="Operational lending marketplace analytics and workflow overview." />

@if (_isLoading)
{
    <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center shadow-sm">
        <div class="text-lg font-semibold text-slate-700">
            Loading dashboard...
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="rounded-2xl border border-red-200 bg-red-50 p-6 text-red-700">
        @_errorMessage
    </div>
}
else if (_dashboard is not null)
{
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">

        <MetricCard Title="Borrowers"
                    Value="@_dashboard.TotalBorrowers.ToString("N0")"
                    Icon="👤" />

        <MetricCard Title="Lenders"
                    Value="@_dashboard.TotalLenders.ToString("N0")"
                    Icon="🏦" />

        <MetricCard Title="Applications"
                    Value="@_dashboard.TotalApplications.ToString("N0")"
                    Icon="📝" />

        <MetricCard Title="Funding Volume"
                    Value="@($"£{_dashboard.TotalFundingVolume:N0}")"
                    Icon="💰" />

        <MetricCard Title="Approved"
                    Value="@_dashboard.ApprovedApplications.ToString("N0")"
                    Icon="✅" />

        <MetricCard Title="Funded"
                    Value="@_dashboard.FundedApplications.ToString("N0")"
                    Icon="🚀" />

        <MetricCard Title="Approval Rate"
                    Value="@($"{_dashboard.ApprovalRate:N2}%")"
                    Icon="📈" />

        <MetricCard Title="Funding Rate"
                    Value="@($"{_dashboard.FundingRate:N2}%")"
                    Icon="📊" />
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 xl:grid-cols-2">

        <div class="rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 px-6 py-4">
                <h3 class="text-lg font-bold text-slate-900">
                    Recent Applications
                </h3>
            </div>

            <div class="overflow-x-auto">
                <table class="min-w-full">
                    <thead class="bg-slate-50">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                                Purpose
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                                Amount
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                                Status
                            </th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-slate-100">
                        @foreach (var application in _dashboard.RecentApplications)
                        {
                            <tr>
                                <td class="px-6 py-4 text-sm font-medium text-slate-900">
                                    @application.Purpose
                                </td>

                                <td class="px-6 py-4 text-sm text-slate-700">
                                    £@application.Amount.ToString("N0")
                                </td>

                                <td class="px-6 py-4">
                                    <StatusBadge Status="@application.Status" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 px-6 py-4">
                <h3 class="text-lg font-bold text-slate-900">
                    Recent Borrowers
                </h3>
            </div>

            <div class="divide-y divide-slate-100">
                @foreach (var borrower in _dashboard.RecentBorrowers)
                {
                    <div class="px-6 py-4">
                        <div class="font-semibold text-slate-900">
                            @borrower.FullName
                        </div>

                        <div class="mt-1 text-sm text-slate-500">
                            @borrower.Email
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private DashboardSummaryDto? _dashboard;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await DashboardApiClient.GetSummaryAsync();

            if (response is null)
            {
                _errorMessage = "No response received from the API.";
                return;
            }

            if (!response.Success)
            {
                _errorMessage = response.Errors.Count > 0
                    ? string.Join(", ", response.Errors)
                    : "Failed to load dashboard.";

                return;
            }

            _dashboard = response.Data;
        }
        catch (Exception exception)
        {
            _errorMessage = $"Unable to load dashboard. {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}