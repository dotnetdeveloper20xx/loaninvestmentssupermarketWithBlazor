@page "/disputes"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,CustomerService")]

<PageHeader Title="Disputes"
            Subtitle="Manage and resolve borrower and lender disputes.">
</PageHeader>

