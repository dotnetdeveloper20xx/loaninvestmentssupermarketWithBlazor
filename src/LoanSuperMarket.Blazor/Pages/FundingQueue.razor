@page "/funding-queue"
@inject FundingApiClient FundingApiClient
@inject NavigationManager Navigation

<PageHeader Title="Funding Queue"
            Subtitle="Review and fund approved loan applications from your product portfolio.">
</PageHeader>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="mb-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
        @_errorMessage
    </div>
}

@if (_noCapital)
{
    <div class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-700">
        ⚠️ You have no remaining capital available for funding. Please top up your account to continue funding loans.
    </div>
}

<div class="mb-6 flex flex-wrap items-end gap-4">
    <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Product Filter</label>
        <input type="text" @bind="_productFilter" @bind:event="oninput"
               placeholder="Filter by product title..."
               class="rounded-lg border border-slate-300 px-3 py-2 text-sm" />
    </div>
    <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Min Amount</label>
        <input type="number" @bind="_minAmount"
               placeholder="Min"
               class="rounded-lg border border-slate-300 px-3 py-2 text-sm w-32" />
    </div>
    <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Max Amount</label>
        <input type="number" @bind="_maxAmount"
               placeholder="Max"
               class="rounded-lg border border-slate-300 px-3 py-2 text-sm w-32" />
    </div>
    <button class="rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700"
            @onclick="LoadQueueAsync">
        Apply Filters
    </button>
</div>

@if (_isLoading)
{
    <div class="flex items-center justify-center py-12">
        <div class="text-slate-500">Loading funding queue...</div>
    </div>
}
else if (_queueItems.Count == 0)
{
    <div class="flex flex-col items-center justify-center py-12">
        <div class="text-4xl mb-4">📋</div>
        <div class="text-lg font-semibold text-slate-700">No applications in queue</div>
        <div class="text-sm text-slate-500 mt-1">There are no approved applications awaiting funding.</div>
    </div>
}
else
{
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full">
            <thead class="bg-slate-50 border-b border-slate-200">
                <tr>
                    <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Borrower</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Credit Tier</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Amount</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Term</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Product</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Rate</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Approved</th>
                    <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var item in _queueItems)
                {
                    <tr class="hover:bg-slate-50">
                        <td class="px-6 py-4 text-sm font-medium text-slate-900">@item.BorrowerName</td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold
                                @(item.CreditTier == "A" ? "bg-green-100 text-green-800" :
                                  item.CreditTier == "B" ? "bg-blue-100 text-blue-800" :
                                  "bg-amber-100 text-amber-800")">
                                @item.CreditTier
                            </span>
                        </td>
                        <td class="px-6 py-4 text-sm font-semibold text-slate-900">£@item.Amount.ToString("N0")</td>
                        <td class="px-6 py-4 text-sm text-slate-700">@item.TermMonths months</td>
                        <td class="px-6 py-4 text-sm text-slate-700">@item.ProductTitle</td>
                        <td class="px-6 py-4 text-sm text-slate-700">@item.EffectiveRate.ToString("N2")%</td>
                        <td class="px-6 py-4 text-sm text-slate-500">@item.ApprovalDate.ToString("dd MMM yyyy")</td>
                        <td class="px-6 py-4 text-right">
                            <button class="rounded-lg border border-blue-200 px-3 py-2 text-xs font-semibold text-blue-700 hover:bg-blue-50"
                                    @onclick="() => ViewDetails(item.ApplicationId)">
                                View Details
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_selectedApplicationId.HasValue)
{
    <FundingDecision ApplicationId="_selectedApplicationId.Value"
                     OnClose="CloseDetails"
                     OnFunded="HandleFunded"
                     OnDeclined="HandleDeclined" />
}

@code {
    private List<FundingQueueItemDto> _queueItems = [];
    private bool _isLoading = true;
    private bool _noCapital;
    private string? _errorMessage;
    private string? _productFilter;
    private decimal? _minAmount;
    private decimal? _maxAmount;
    private Guid? _selectedApplicationId;

    protected override async Task OnInitializedAsync()
    {
        await LoadQueueAsync();
    }

    private async Task LoadQueueAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await FundingApiClient.GetFundingQueueAsync(
                _productFilter, _minAmount, _maxAmount);

            if (response is null)
            {
                _errorMessage = "No response received from the API.";
                return;
            }

            if (!response.Success)
            {
                _errorMessage = response.Errors.Count > 0
                    ? string.Join(", ", response.Errors)
                    : "Failed to load funding queue.";
                return;
            }

            _queueItems = response.Data?.ToList() ?? [];
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unable to load funding queue. {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ViewDetails(Guid applicationId)
    {
        _selectedApplicationId = applicationId;
    }

    private void CloseDetails()
    {
        _selectedApplicationId = null;
    }

    private async Task HandleFunded()
    {
        _selectedApplicationId = null;
        await LoadQueueAsync();
    }

    private async Task HandleDeclined()
    {
        _selectedApplicationId = null;
        await LoadQueueAsync();
    }
}
