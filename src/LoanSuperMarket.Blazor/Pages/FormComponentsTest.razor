@page "/form-components-test"
@inject ToastService ToastService

<PageHeader Title="Enhanced Form Components"
            Subtitle="Financial input components with smart formatting, validation, and real-time calculations." />

<div class="space-y-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

        <!-- Currency Input Test -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-semibold text-slate-900 mb-4">Currency Input</h3>
            <div class="space-y-4">
                <AppCurrencyInput Value="testLoanAmount"
                                  ValueChanged="v => { testLoanAmount = v; StateHasChanged(); }"
                                  Label="Loan Amount"
                                  Currency="GBP"
                                  MinValue="@(1000m)"
                                  MaxValue="@(1000000m)"
                                  Required="true" />

                <AppCurrencyInput Value="testSalary"
                                  ValueChanged="v => { testSalary = v; StateHasChanged(); }"
                                  Label="Annual Salary"
                                  Currency="GBP"
                                  MinValue="@(15000m)"
                                  MaxValue="@(500000m)" />

                <div class="bg-slate-50 rounded-lg p-3 text-sm text-slate-600">
                    <strong>Live Values:</strong><br />
                    Loan: £@testLoanAmount.ToString("N0") |
                    Salary: £@testSalary.ToString("N0") |
                    Ratio: @(testSalary > 0 ? (testLoanAmount / testSalary).ToString("F1") : "0")x
                </div>
            </div>
        </div>

        <!-- Percentage Input Test -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-semibold text-slate-900 mb-4">Percentage Input</h3>
            <div class="space-y-4">
                <AppPercentageInput Value="testInterestRate"
                                    ValueChanged="v => { testInterestRate = v; StateHasChanged(); }"
                                    Label="Interest Rate"
                                    DecimalPlaces="3"
                                    MinValue="@(0.1m)"
                                    MaxValue="@(15m)"
                                    ShowMarketComparison="true"
                                    MarketAverageRate="@(4.5m)" />

                <AppPercentageInput Value="testDepositPct"
                                    ValueChanged="v => { testDepositPct = v; StateHasChanged(); }"
                                    Label="Deposit Percentage"
                                    DecimalPlaces="1"
                                    MinValue="@(5m)"
                                    MaxValue="@(50m)"
                                    Suffix="% deposit" />

                <div class="bg-slate-50 rounded-lg p-3 text-sm text-slate-600">
                    <strong>Live Values:</strong><br />
                    Rate: @testInterestRate.ToString("F3")% |
                    Deposit: @testDepositPct.ToString("F1")% (£@((testLoanAmount * testDepositPct / 100).ToString("N0")))
                </div>
            </div>
        </div>

        <!-- Loan Term Input Test -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-semibold text-slate-900 mb-4">Loan Term Input</h3>
            <div class="space-y-4">
                <AppLoanTermInput Value="testLoanTerm"
                                  ValueChanged="v => { testLoanTerm = v; StateHasChanged(); }"
                                  Label="Loan Term"
                                  MinMonths="6"
                                  MaxMonths="360"
                                  ShowConversion="true" />

                <div class="bg-slate-50 rounded-lg p-3 text-sm text-slate-600">
                    <strong>Live Values:</strong><br />
                    Term: @testLoanTerm months (@(testLoanTerm / 12.0).ToString("F1") years)
                </div>
            </div>
        </div>

        <!-- Quick Calculation -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-semibold text-slate-900 mb-4">Live Calculation</h3>
            <div class="space-y-3">
                <div class="flex justify-between">
                    <span class="text-sm text-slate-600">Loan Amount:</span>
                    <span class="text-sm font-semibold">£@testLoanAmount.ToString("N0")</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-sm text-slate-600">Interest Rate:</span>
                    <span class="text-sm font-semibold">@testInterestRate.ToString("F3")%</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-sm text-slate-600">Term:</span>
                    <span class="text-sm font-semibold">@testLoanTerm months</span>
                </div>
                <hr class="border-slate-200" />
                <div class="flex justify-between">
                    <span class="text-sm font-semibold text-slate-900">Est. Monthly Payment:</span>
                    <span class="text-sm font-bold text-blue-600">£@GetEstimatedPayment().ToString("N2")</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-sm text-slate-600">Payment-to-Income:</span>
                    <span class="text-sm font-semibold @GetPaymentToIncomeClass()">@GetPaymentToIncomeRatio().ToString("F1")%</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Full Loan Calculator -->
    <AppLoanCalculator Principal="testLoanAmount"
                       InterestRate="testInterestRate"
                       TermInMonths="testLoanTerm"
                       Currency="GBP"
                       ShowAmortization="true"
                       ShowPaymentFrequency="true"
                       ShowAffordabilityCheck="true"
                       MonthlyIncome="@(testSalary / 12)" />

    <!-- Test Actions -->
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-slate-900 mb-4">Test Actions</h3>
        <div class="flex flex-wrap gap-3">
            <button type="button"
                    class="rounded-xl bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700"
                    @onclick="LoadSampleData">
                Load Sample Data
            </button>
            <button type="button"
                    class="rounded-xl border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
                    @onclick="ClearAll">
                Clear All
            </button>
        </div>
    </div>
</div>

@code {
    private decimal testLoanAmount = 250000;
    private decimal testSalary = 50000;
    private decimal testInterestRate = 4.5m;
    private decimal testDepositPct = 20;
    private int testLoanTerm = 300;

    private decimal GetEstimatedPayment()
    {
        if (testLoanAmount == 0 || testInterestRate == 0 || testLoanTerm == 0) return 0;
        var monthlyRate = (double)(testInterestRate / 100 / 12);
        var powFactor = Math.Pow(1 + monthlyRate, testLoanTerm);
        var payment = (double)testLoanAmount * (monthlyRate * powFactor) / (powFactor - 1);
        return Math.Round((decimal)payment, 2);
    }

    private decimal GetPaymentToIncomeRatio()
    {
        if (testSalary == 0) return 0;
        return GetEstimatedPayment() / (testSalary / 12) * 100;
    }

    private string GetPaymentToIncomeClass() => GetPaymentToIncomeRatio() switch
    {
        <= 28 => "text-green-600",
        <= 36 => "text-yellow-600",
        <= 43 => "text-orange-600",
        _ => "text-red-600"
    };

    private void LoadSampleData()
    {
        testLoanAmount = 350000;
        testSalary = 75000;
        testInterestRate = 5.25m;
        testDepositPct = 15;
        testLoanTerm = 360;
        ToastService.ShowSuccess("Sample loaded", "All fields populated with sample values");
    }

    private void ClearAll()
    {
        testLoanAmount = 0;
        testSalary = 0;
        testInterestRate = 0;
        testDepositPct = 0;
        testLoanTerm = 0;
        ToastService.ShowSuccess("Cleared", "All fields reset");
    }
}
