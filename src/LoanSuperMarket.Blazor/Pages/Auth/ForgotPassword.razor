@page "/forgot-password"
@using LoanSuperMarket.Shared.Auth
@using LoanSuperMarket.Shared.Common
@inject AuthApiClient AuthApiClient

<PageHeader Title="Forgot Password"
            Subtitle="Enter your email address and we'll send you a reset link." />

<div class="mx-auto max-w-md">
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
        @if (_submitted)
        {
            <div class="text-center">
                <div class="mb-4 text-4xl">📧</div>
                <h3 class="mb-2 text-lg font-semibold text-slate-900">Check Your Email</h3>
                <p class="mb-6 text-sm text-slate-600">
                    If an account exists for <strong>@_email</strong>, we've sent a password reset link.
                    Please check your inbox and spam folder.
                </p>
                <a href="/login" class="text-sm font-medium text-blue-600 hover:text-blue-700">
                    Back to Sign In
                </a>
            </div>
        }
        else
        {
            <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync" FormName="ForgotPasswordForm">
                <DataAnnotationsValidator />

                <div class="space-y-5">
                    <div>
                        <label for="email" class="mb-1 block text-sm font-medium text-slate-700">Email Address</label>
                        <InputText id="email" @bind-Value="_model.Email"
                                   class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                                   placeholder="you@example.com" />
                        <ValidationMessage For="@(() => _model.Email)" class="mt-1 text-xs text-red-600" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                            @_errorMessage
                        </div>
                    }

                    <button type="submit" disabled="@_isSubmitting"
                            class="w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 disabled:opacity-50">
                        @if (_isSubmitting)
                        {
                            <span>Sending...</span>
                        }
                        else
                        {
                            <span>Send Reset Link</span>
                        }
                    </button>

                    <div class="text-center text-sm">
                        <a href="/login" class="font-medium text-blue-600 hover:text-blue-700">Back to Sign In</a>
                    </div>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    private readonly ForgotPasswordRequest _model = new();
    private bool _isSubmitting;
    private bool _submitted;
    private string _email = string.Empty;
    private string? _errorMessage;

    private async Task HandleSubmitAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            _email = _model.Email;
            var response = await AuthApiClient.ForgotPasswordAsync(_model.Email);

            // Always show success message to prevent email enumeration
            _submitted = true;
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred. {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
