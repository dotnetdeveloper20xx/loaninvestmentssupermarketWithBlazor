@page "/login"
@using LoanSuperMarket.Shared.Auth
@using LoanSuperMarket.Shared.Common
@inject AuthApiClient AuthApiClient
@inject NavigationManager NavigationManager

<PageHeader Title="Sign In"
            Subtitle="Enter your credentials to access your account." />

<div class="mx-auto max-w-md">
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
        <EditForm Model="_loginRequest" OnValidSubmit="HandleLoginAsync" FormName="LoginForm">
            <DataAnnotationsValidator />

            <div class="space-y-5">
                <div>
                    <label for="email" class="mb-1 block text-sm font-medium text-slate-700">Email</label>
                    <InputText id="email" @bind-Value="_loginRequest.Email"
                               class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                               placeholder="you@example.com" />
                    <ValidationMessage For="@(() => _loginRequest.Email)" class="mt-1 text-xs text-red-600" />
                </div>

                <div>
                    <label for="password" class="mb-1 block text-sm font-medium text-slate-700">Password</label>
                    <InputText id="password" @bind-Value="_loginRequest.Password" type="password"
                               class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                               placeholder="••••••••" />
                    <ValidationMessage For="@(() => _loginRequest.Password)" class="mt-1 text-xs text-red-600" />
                </div>

                <div class="flex items-center gap-2">
                    <InputCheckbox id="rememberMe" @bind-Value="_loginRequest.RememberMe"
                                   class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
                    <label for="rememberMe" class="text-sm text-slate-600">Remember me</label>
                </div>

                @if (_requiresTwoFactor)
                {
                    <div>
                        <label for="totpCode" class="mb-1 block text-sm font-medium text-slate-700">Two-Factor Code</label>
                        <InputText id="totpCode" @bind-Value="_loginRequest.TotpCode"
                                   class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm tracking-widest focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                                   placeholder="000000" maxlength="6" />
                        <p class="mt-1 text-xs text-slate-500">Enter the 6-digit code from your authenticator app.</p>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                        @_errorMessage
                    </div>
                }

                <button type="submit" disabled="@_isSubmitting"
                        class="w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 disabled:opacity-50">
                    @if (_isSubmitting)
                    {
                        <span>Signing in...</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                    }
                </button>

                <div class="flex items-center justify-between text-sm">
                    <a href="/forgot-password" class="text-blue-600 hover:text-blue-700">Forgot password?</a>
                    <a href="/register" class="text-blue-600 hover:text-blue-700">Create account</a>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private readonly LoginRequest _loginRequest = new();
    private bool _isSubmitting;
    private bool _requiresTwoFactor;
    private string? _errorMessage;

    private async Task HandleLoginAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var response = await AuthApiClient.LoginAsync(_loginRequest);

            if (response is null)
            {
                _errorMessage = "No response received from the server.";
                return;
            }

            if (response.Success && response.Data is not null)
            {
                // Tokens are stored by AuthApiClient via JwtAuthenticationStateProvider
                var redirectUrl = GetReturnUrl();
                NavigationManager.NavigateTo(redirectUrl);
                return;
            }

            // Check if 2FA is required based on error message
            var errors = response.Errors.Count > 0
                ? string.Join(" ", response.Errors)
                : response.Message ?? string.Empty;

            if (errors.Contains("two-factor", StringComparison.OrdinalIgnoreCase) ||
                errors.Contains("2fa", StringComparison.OrdinalIgnoreCase) ||
                errors.Contains("totp", StringComparison.OrdinalIgnoreCase))
            {
                _requiresTwoFactor = true;
                _errorMessage = "Please enter your two-factor authentication code.";
                return;
            }

            _errorMessage = response.Errors.Count > 0
                ? string.Join(", ", response.Errors)
                : response.Message ?? "Login failed. Please check your credentials.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred. {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private string GetReturnUrl()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = uri.Query;

        if (!string.IsNullOrEmpty(query) && query.StartsWith('?'))
        {
            var pairs = query[1..].Split('&');
            foreach (var pair in pairs)
            {
                var parts = pair.Split('=', 2);
                if (parts.Length == 2 &&
                    parts[0].Equals("returnUrl", StringComparison.OrdinalIgnoreCase))
                {
                    var decoded = Uri.UnescapeDataString(parts[1]);
                    // Only allow relative URLs to prevent open redirect
                    if (!string.IsNullOrWhiteSpace(decoded))
                    {
                        return decoded.StartsWith('/') ? decoded : $"/{decoded}";
                    }
                }
            }
        }

        return "/";
    }
}
