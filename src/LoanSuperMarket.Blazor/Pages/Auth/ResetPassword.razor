@page "/reset-password"
@using LoanSuperMarket.Shared.Auth
@using LoanSuperMarket.Shared.Common
@inject AuthApiClient AuthApiClient
@inject NavigationManager NavigationManager

<PageHeader Title="Reset Password"
            Subtitle="Enter your new password below." />

<div class="mx-auto max-w-md">
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
        @if (_resetComplete)
        {
            <div class="text-center">
                <div class="mb-4 text-4xl">✅</div>
                <h3 class="mb-2 text-lg font-semibold text-slate-900">Password Reset Successful</h3>
                <p class="mb-6 text-sm text-slate-600">
                    Your password has been updated. You can now sign in with your new password.
                </p>
                <a href="/login"
                   class="inline-block rounded-lg bg-blue-600 px-6 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">
                    Sign In
                </a>
            </div>
        }
        else
        {
            <EditForm Model="_resetRequest" OnValidSubmit="HandleResetAsync" FormName="ResetPasswordForm">
                <DataAnnotationsValidator />

                <div class="space-y-5">
                    <div>
                        <label for="email" class="mb-1 block text-sm font-medium text-slate-700">Email Address</label>
                        <InputText id="email" @bind-Value="_resetRequest.Email"
                                   class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                                   placeholder="you@example.com" />
                        <ValidationMessage For="@(() => _resetRequest.Email)" class="mt-1 text-xs text-red-600" />
                    </div>

                    <div>
                        <label for="newPassword" class="mb-1 block text-sm font-medium text-slate-700">New Password</label>
                        <InputText id="newPassword" @bind-Value="_resetRequest.NewPassword" type="password"
                                   class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                                   placeholder="••••••••" />
                        <ValidationMessage For="@(() => _resetRequest.NewPassword)" class="mt-1 text-xs text-red-600" />
                        <p class="mt-1 text-xs text-slate-500">Minimum 8 characters with uppercase, lowercase, digit, and special character.</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                            @_errorMessage
                        </div>
                    }

                    <button type="submit" disabled="@_isSubmitting"
                            class="w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 disabled:opacity-50">
                        @if (_isSubmitting)
                        {
                            <span>Resetting...</span>
                        }
                        else
                        {
                            <span>Reset Password</span>
                        }
                    </button>

                    <div class="text-center text-sm">
                        <a href="/login" class="font-medium text-blue-600 hover:text-blue-700">Back to Sign In</a>
                    </div>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    private readonly ResetPasswordRequest _resetRequest = new();
    private bool _isSubmitting;
    private bool _resetComplete;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        // Extract token and email from URL query parameters
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);

        if (!string.IsNullOrWhiteSpace(uri.Query))
        {
            var queryParts = uri.Query.TrimStart('?').Split('&');
            foreach (var part in queryParts)
            {
                var keyValue = part.Split('=', 2);
                if (keyValue.Length != 2) continue;

                var key = Uri.UnescapeDataString(keyValue[0]);
                var value = Uri.UnescapeDataString(keyValue[1]);

                if (key.Equals("token", StringComparison.OrdinalIgnoreCase))
                    _resetRequest.Token = value;
                else if (key.Equals("email", StringComparison.OrdinalIgnoreCase))
                    _resetRequest.Email = value;
            }
        }
    }

    private async Task HandleResetAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            if (string.IsNullOrWhiteSpace(_resetRequest.Token))
            {
                _errorMessage = "Invalid or missing reset token. Please use the link from your email.";
                return;
            }

            var response = await AuthApiClient.ResetPasswordAsync(_resetRequest);

            if (response is null)
            {
                _errorMessage = "No response received from the server.";
                return;
            }

            if (response.Success)
            {
                _resetComplete = true;
                return;
            }

            _errorMessage = response.Errors.Count > 0
                ? string.Join(", ", response.Errors)
                : response.Message ?? "Password reset failed. The link may have expired.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred. {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
