@page "/loan-applications"
@inject LoanApplicationsApiClient LoanApplicationsApiClient
@inject ToastService ToastService
@inject ModalService ModalService

<PageHeader Title="Loan Applications"
            Subtitle="Manage borrower applications, review status and funding pipeline.">
    <ActionContent>
        <button class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-700"
                @onclick="OpenCreateModal">
            + New Application
        </button>
    </ActionContent>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="mb-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
        @_errorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(_workflowMessage))
{
    <div class="mb-6 rounded-2xl border border-green-200 bg-green-50 p-4 text-sm text-green-700">
        @_workflowMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(_workflowError))
{
    <div class="mb-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
        @_workflowError
    </div>
}

<div class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-4">
        <div class="lg:col-span-2">
            <label class="mb-2 block text-sm font-semibold text-slate-700">
                Search applications
            </label>

            <input class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-100"
                   placeholder="Search by purpose, borrower ID or product ID..."
                   @bind="_searchText"
                   @bind:event="oninput" />
        </div>

        <div>
            <label class="mb-2 block text-sm font-semibold text-slate-700">
                Status
            </label>

            <select class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100"
                    @bind="_selectedStatus">
                <option value="">All statuses</option>
                <option value="Submitted">Submitted</option>
                <option value="UnderReview">Under Review</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
                <option value="Funded">Funded</option>
                <option value="Withdrawn">Withdrawn</option>
            </select>
        </div>

        <div class="flex items-end">
            <button class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50"
                    @onclick="ClearFilters">
                Clear Filters
            </button>
        </div>
    </div>

    <div class="mt-4 text-sm text-slate-500">
        Showing <span class="font-semibold text-slate-800">@FilteredApplications.Count</span>
        of <span class="font-semibold text-slate-800">@_applications.Count</span> applications
    </div>
</div>

<AppDataTable Title="Loan Application Pipeline"
              Subtitle="Operational view of submitted borrower applications."
              IsLoading="_isLoading"
              IsEmpty="@(!_isLoading && FilteredApplications.Count == 0)"
              LoadingText="Loading loan applications..."
              EmptyIcon="📝"
              EmptyTitle="No loan applications found"
              EmptyMessage="No applications match the current search or filter criteria.">

    <HeaderActions>
        <button class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50"
                @onclick="LoadApplicationsAsync">
            Refresh
        </button>
    </HeaderActions>

    <EmptyActions>
        <button class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-700"
                @onclick="OpenCreateModal">
            Create Application
        </button>
    </EmptyActions>

    <HeaderTemplate>
        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Application</th>
        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Amount</th>
        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Term</th>
        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Status</th>
        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Submitted</th>
        <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">Actions</th>
    </HeaderTemplate>

    <RowTemplate>
        @foreach (var application in FilteredApplications)
        {
            <tr class="hover:bg-slate-50">
                <td class="px-6 py-4">
                    <div class="font-semibold text-slate-900">@application.Purpose</div>
                    <div class="mt-1 text-xs text-slate-500">Borrower: @application.BorrowerId</div>
                    <div class="mt-1 text-xs text-slate-500">Product: @application.LoanProductId</div>
                </td>

                <td class="px-6 py-4 text-sm font-semibold text-slate-900">
                    £@application.RequestedAmount.ToString("N0")
                </td>

                <td class="px-6 py-4 text-sm text-slate-700">
                    @application.TermMonths months
                </td>

                <td class="px-6 py-4">
                    <StatusBadge Status="@application.Status" />
                </td>

                <td class="px-6 py-4 text-sm text-slate-500">
                    @application.SubmittedAtUtc.ToLocalTime().ToString("dd MMM yyyy")
                </td>

                <td class="px-6 py-4 text-right">
                    <div class="flex justify-end gap-2">
                        <button class="rounded-lg border border-purple-200 px-3 py-2 text-xs font-semibold text-purple-700 hover:bg-purple-50 disabled:opacity-50"
                                disabled="@(_activeWorkflowId == application.Id || application.Status != "Submitted")"
                                @onclick="() => ConfirmReview(application.Id)">
                            Review
                        </button>

                        <button class="rounded-lg border border-green-200 px-3 py-2 text-xs font-semibold text-green-700 hover:bg-green-50 disabled:opacity-50"
                                disabled="@(_activeWorkflowId == application.Id || application.Status != "UnderReview")"
                                @onclick="() => ConfirmApprove(application.Id)">
                            Approve
                        </button>

                        <button class="rounded-lg border border-red-200 px-3 py-2 text-xs font-semibold text-red-700 hover:bg-red-50 disabled:opacity-50"
                                disabled="@(_activeWorkflowId == application.Id || application.Status is "Approved" or "Funded" or "Rejected")"
                                @onclick="() => ConfirmReject(application.Id)">
                            Reject
                        </button>

                        <button class="rounded-lg border border-blue-200 px-3 py-2 text-xs font-semibold text-blue-700 hover:bg-blue-50 disabled:opacity-50"
                                disabled="@(_activeWorkflowId == application.Id || application.Status != "Approved")"
                                @onclick="() => ConfirmFund(application.Id)">
                            Fund
                        </button>
                    </div>
                </td>
            </tr>
        }
    </RowTemplate>
</AppDataTable>

<CreateLoanApplicationModal IsOpen="_isCreateModalOpen"
                            OnClose="CloseCreateModal"
                            OnCreated="HandleApplicationCreated" />

@code {
    private List<LoanApplicationDto> _applications = [];
    private bool _isLoading = true;
    private bool _isCreateModalOpen;
    private string? _errorMessage;
    private string _searchText = string.Empty;
    private string _selectedStatus = string.Empty;

    private Guid? _activeWorkflowId;
    private string? _workflowMessage;
    private string? _workflowError;

    private List<LoanApplicationDto> FilteredApplications
    {
        get
        {
            var query = _applications.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                query = query.Where(application =>
                    application.Purpose.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                    || application.BorrowerId.ToString().Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                    || application.LoanProductId.ToString().Contains(_searchText, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_selectedStatus))
            {
                query = query.Where(application =>
                    application.Status.Equals(_selectedStatus, StringComparison.OrdinalIgnoreCase));
            }

            return query
                .OrderByDescending(x => x.SubmittedAtUtc)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadApplicationsAsync();
    }

    private async Task LoadApplicationsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await LoanApplicationsApiClient.GetLoanApplicationsAsync();

            if (response is null)
            {
                _errorMessage = "No response received from the API.";
                return;
            }

            if (!response.Success)
            {
                _errorMessage = response.Errors.Count > 0
                    ? string.Join(", ", response.Errors)
                    : "Failed to load loan applications.";

                return;
            }

            _applications = response.Data?.ToList() ?? [];
        }
        catch (Exception exception)
        {
            _errorMessage = $"Unable to load loan applications. {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        _isCreateModalOpen = true;
    }

    private void CloseCreateModal()
    {
        _isCreateModalOpen = false;
    }

    private async Task HandleApplicationCreated()
    {
        await LoadApplicationsAsync();
    }

    private void ClearFilters()
    {
        _searchText = string.Empty;
        _selectedStatus = string.Empty;
    }

    private async Task MarkUnderReviewAsync(Guid id)
    {
        await RunWorkflowAsync(id, "review");
    }

    private async Task ApproveAsync(Guid id)
    {
        await RunWorkflowAsync(id, "approve");
    }

    private async Task RejectAsync(Guid id)
    {
        await RunWorkflowAsync(id, "reject");
    }

    private async Task FundAsync(Guid id)
    {
        await RunWorkflowAsync(id, "fund");
    }

    private void ConfirmReview(Guid id)
    {
        ModalService.ShowConfirmation(new ConfirmationModalRequest
        {
            Title = "Move application under review?",
            Message = "This will move the loan application into the underwriting review stage.",
            ConfirmText = "Move to Review",
            Intent = ModalIntent.Info,
            OnConfirmAsync = async () => await MarkUnderReviewAsync(id)
        });
    }

    private void ConfirmApprove(Guid id)
    {
        ModalService.ShowConfirmation(new ConfirmationModalRequest
        {
            Title = "Approve this application?",
            Message = "This will approve the loan application and make it eligible for funding.",
            ConfirmText = "Approve",
            Intent = ModalIntent.Success,
            OnConfirmAsync = async () => await ApproveAsync(id)
        });
    }

    private void ConfirmReject(Guid id)
    {
        ModalService.ShowConfirmation(new ConfirmationModalRequest
        {
            Title = "Reject this application?",
            Message = "This action will reject the loan application.",
            ConfirmText = "Reject",
            Intent = ModalIntent.Danger,
            OnConfirmAsync = async () => await RejectAsync(id)
        });
    }

    private void ConfirmFund(Guid id)
    {
        ModalService.ShowConfirmation(new ConfirmationModalRequest
        {
            Title = "Fund this application?",
            Message = "This will mark the approved application as funded.",
            ConfirmText = "Fund Application",
            Intent = ModalIntent.Warning,
            OnConfirmAsync = async () => await FundAsync(id)
        });
    }

    private async Task RunWorkflowAsync(Guid id, string action)
    {
        _activeWorkflowId = id;
        _workflowMessage = null;
        _workflowError = null;

        try
        {
            var response = action switch
            {
                "review" => await LoanApplicationsApiClient.MarkUnderReviewAsync(id),
                "approve" => await LoanApplicationsApiClient.ApproveAsync(id),
                "reject" => await LoanApplicationsApiClient.RejectAsync(id),
                "fund" => await LoanApplicationsApiClient.FundAsync(id),
                _ => null
            };

            if (response is null)
            {
                _workflowError = "No response received from the API.";
                return;
            }

            if (!response.Success)
            {
                var errorMessage = response.Errors.Count > 0
                                    ? string.Join(", ", response.Errors)
                                    : "Workflow action failed.";

                ToastService.ShowError("Workflow failed", errorMessage);
                _workflowError = errorMessage;

                return;
            }

            var successMessage = response.Message
                     ?? response.Data
                     ?? "Workflow action completed.";

            ToastService.ShowSuccess("Workflow completed", successMessage);

            await LoadApplicationsAsync();
        }
        catch (Exception exception)
        {
            _workflowError = $"Workflow action failed. {exception.Message}";
            ToastService.ShowError("Workflow failed", _workflowError);
        }
        finally
        {
            _activeWorkflowId = null;
        }
    }
    
}