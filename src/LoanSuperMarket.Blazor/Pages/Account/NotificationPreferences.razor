@page "/account/notifications"
@using Microsoft.AspNetCore.Authorization
@using LoanSuperMarket.Shared.Configuration
@attribute [Authorize]
@inject HttpClient Http
@inject ToastService ToastService

<PageHeader Title="Notification Preferences"
            Subtitle="Choose what notifications you receive and how.">
</PageHeader>

@if (_prefs is not null)
{
    <div class="max-w-2xl">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-6">

            <div class="border-b border-slate-100 pb-4">
                <h3 class="text-sm font-semibold text-slate-700 mb-3">Payment Notifications</h3>
                <div class="space-y-3">
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" @bind="_prefs.PaymentReminders"
                               class="h-4 w-4 rounded border-slate-300 text-blue-600" />
                        <div>
                            <div class="text-sm font-medium text-slate-900">Payment Reminders</div>
                            <div class="text-xs text-slate-500">Get notified before a payment is due</div>
                        </div>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" @bind="_prefs.LatePaymentNotices"
                               class="h-4 w-4 rounded border-slate-300 text-blue-600" />
                        <div>
                            <div class="text-sm font-medium text-slate-900">Late Payment Notices</div>
                            <div class="text-xs text-slate-500">Get notified when a payment becomes overdue</div>
                        </div>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" @bind="_prefs.DefaultNotices"
                               class="h-4 w-4 rounded border-slate-300 text-blue-600" />
                        <div>
                            <div class="text-sm font-medium text-slate-900">Default Notices</div>
                            <div class="text-xs text-slate-500">Get notified when a loan enters default</div>
                        </div>
                    </label>
                </div>
            </div>

            <div class="border-b border-slate-100 pb-4">
                <h3 class="text-sm font-semibold text-slate-700 mb-3">Funding Notifications</h3>
                <div class="space-y-3">
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" @bind="_prefs.FundingConfirmations"
                               class="h-4 w-4 rounded border-slate-300 text-blue-600" />
                        <div>
                            <div class="text-sm font-medium text-slate-900">Funding Confirmations</div>
                            <div class="text-xs text-slate-500">Get notified when your loan is funded</div>
                        </div>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" @bind="_prefs.PortfolioSummary"
                               class="h-4 w-4 rounded border-slate-300 text-blue-600" />
                        <div>
                            <div class="text-sm font-medium text-slate-900">Weekly Portfolio Summary</div>
                            <div class="text-xs text-slate-500">Receive a weekly summary of your portfolio performance</div>
                        </div>
                    </label>
                </div>
            </div>

            <div>
                <h3 class="text-sm font-semibold text-slate-700 mb-3">Delivery Channel</h3>
                <select @bind="_prefs.PreferredChannel"
                        class="rounded-lg border border-slate-300 px-3 py-2 text-sm">
                    <option value="Email">Email</option>
                    <option value="SMS">SMS</option>
                    <option value="Both">Email + SMS</option>
                    <option value="InApp">In-App Only</option>
                </select>
            </div>
        </div>

        <div class="mt-6 flex justify-end">
            <button class="rounded-xl bg-blue-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700"
                    @onclick="SavePreferences"
                    disabled="@_isSaving">
                @(_isSaving ? "Saving..." : "Save Preferences")
            </button>
        </div>
    </div>
}
else
{
    <div class="py-12 text-center text-slate-500">Loading preferences...</div>
}

@code {
    private NotificationPreferencesDto? _prefs;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<NotificationPreferencesDto>>(
                "api/notifications/preferences");
            if (response?.Success == true)
            {
                _prefs = response.Data;
            }
        }
        catch
        {
            _prefs = new NotificationPreferencesDto();
        }
    }

    private async Task SavePreferences()
    {
        if (_prefs is null) return;

        _isSaving = true;
        try
        {
            var response = await Http.PutAsJsonAsync("api/notifications/preferences", _prefs);
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<string>>();

            if (result?.Success == true)
            {
                ToastService.ShowSuccess("Saved", "Notification preferences updated.");
            }
            else
            {
                ToastService.ShowError("Error", result?.Errors.FirstOrDefault() ?? "Failed to save.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Error", ex.Message);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
