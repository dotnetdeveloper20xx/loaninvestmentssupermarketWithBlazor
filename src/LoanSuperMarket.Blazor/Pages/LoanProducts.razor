@page "/loan-products"
@inject LoanProductsApiClient LoanProductsApiClient

<PageHeader Title="Loan Products"
            Subtitle="Browse and manage lending products available in the marketplace.">
    <ActionContent>
        <button class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-700"
                @onclick="OpenCreateModal">
            + New Loan Product
        </button>
    </ActionContent>
</PageHeader>

@if (_isLoading)
{
    <AppCard>
        <div class="flex min-h-64 items-center justify-center">
            <div class="text-center">
                <div class="mx-auto h-10 w-10 animate-spin rounded-full border-4 border-blue-100 border-t-blue-600"></div>
                <p class="mt-4 text-sm text-slate-500">Loading loan products...</p>
            </div>
        </div>
    </AppCard>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
        @_errorMessage
    </div>
}
else if (_loanProducts.Count == 0)
{
    <AppCard>
        <div class="flex min-h-64 flex-col items-center justify-center text-center">
            <div class="text-5xl">🏦</div>
            <h3 class="mt-4 text-lg font-semibold text-slate-900">No loan products found</h3>
            <p class="mt-2 max-w-md text-sm text-slate-500">
                Once lenders create loan products, they will appear here.
            </p>
            <button class="mt-6 rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-700"
                    @onclick="OpenCreateModal">
                Create First Loan Product
            </button>
        </div>
    </AppCard>
}
else
{
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 xl:grid-cols-3">
        @foreach (var product in _loanProducts)
        {
            <AppCard Class="transition-shadow hover:shadow-md">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900">@product.Title</h3>
                        <p class="mt-2 line-clamp-3 text-sm text-slate-500">@product.Description</p>
                    </div>

                    <span class="@GetStatusClass(product.Status)">
                        @product.Status
                    </span>
                </div>

                <div class="mt-6 grid grid-cols-2 gap-4">
                    <div class="rounded-xl bg-slate-50 p-4">
                        <div class="text-xs font-medium uppercase tracking-wide text-slate-500">Amount Range</div>
                        <div class="mt-2 text-sm font-semibold text-slate-900">
                            £@product.MinimumAmount.ToString("N0") - £@product.MaximumAmount.ToString("N0")
                        </div>
                    </div>

                    <div class="rounded-xl bg-slate-50 p-4">
                        <div class="text-xs font-medium uppercase tracking-wide text-slate-500">Interest Rate</div>
                        <div class="mt-2 text-sm font-semibold text-slate-900">
                            @product.InterestRate.ToString("N2")%
                        </div>
                    </div>

                    <div class="rounded-xl bg-slate-50 p-4">
                        <div class="text-xs font-medium uppercase tracking-wide text-slate-500">Term</div>
                        <div class="mt-2 text-sm font-semibold text-slate-900">
                            @product.MinimumTermMonths - @product.MaximumTermMonths months
                        </div>
                    </div>

                    <div class="rounded-xl bg-slate-50 p-4">
                        <div class="text-xs font-medium uppercase tracking-wide text-slate-500">Currency</div>
                        <div class="mt-2 text-sm font-semibold text-slate-900">@product.Currency</div>
                    </div>
                </div>

                <div class="mt-6 flex items-center justify-between border-t border-slate-100 pt-4">
                    <div class="text-xs text-slate-500">
                        Created @product.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")
                    </div>

                    <button class="rounded-lg border border-blue-200 px-3 py-2 text-xs font-semibold text-blue-700 hover:bg-blue-50">
                        View Details
                    </button>
                </div>
            </AppCard>
        }
    </div>
}

@if (_isCreateModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 px-4 backdrop-blur-sm">
        <div class="max-h-[90vh] w-full max-w-3xl overflow-y-auto rounded-2xl bg-white p-8 shadow-2xl">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h3 class="text-2xl font-bold text-slate-900">Create Loan Product</h3>
                    <p class="mt-2 text-sm text-slate-500">
                        Add a new lending product for borrowers to apply against.
                    </p>
                </div>

                <button class="rounded-full p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700"
                        @onclick="CloseCreateModal">
                    ✕
                </button>
            </div>

            @if (_createErrors.Count > 0)
            {
                <div class="mt-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                    <strong>Unable to create product</strong>
                    <ul class="mt-2 list-disc pl-5">
                        @foreach (var error in _createErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2">
                <div class="md:col-span-2">
                    <label class="mb-2 block text-sm font-semibold text-slate-700">
                        Product title
                    </label>
                    <input class="@InputClass"
                           @bind="_createModel.Title"
                           placeholder="Prime Personal Loan" />
                </div>

                <div class="md:col-span-2">
                    <label class="mb-2 block text-sm font-semibold text-slate-700">
                        Description
                    </label>
                    <textarea class="@TextAreaClass"
                              @bind="_createModel.Description"
                              placeholder="Describe who this product is suitable for..."></textarea>
                </div>

                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700">
                        Minimum amount
                    </label>
                    <input type="number" class="@InputClass"
                           @bind="_createModel.MinimumAmount" />
                </div>

                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700">
                        Maximum amount
                    </label>
                    <input type="number" class="@InputClass"
                           @bind="_createModel.MaximumAmount" />
                </div>

                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700">
                        Interest rate %
                    </label>
                    <input type="number" step="0.01" class="@InputClass"
                           @bind="_createModel.InterestRate" />
                </div>

                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700">
                        Lender ID
                    </label>
                    <input class="@InputClass"
                           @bind="_lenderIdText" />
                </div>

                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700">
                        Minimum term months
                    </label>
                    <input type="number" class="@InputClass"
                           @bind="_createModel.MinimumTermMonths" />
                </div>

                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700">
                        Maximum term months
                    </label>
                    <input type="number" class="@InputClass"
                           @bind="_createModel.MaximumTermMonths" />
                </div>
            </div>

            <div class="mt-8 flex justify-end gap-3 border-t border-slate-200 pt-5">
                <button class="rounded-xl px-5 py-3 text-sm font-semibold text-slate-600 hover:bg-slate-100"
                        @onclick="CloseCreateModal"
                        disabled="@_isSaving">
                    Cancel
                </button>

                <button class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 disabled:opacity-60"
                        @onclick="CreateLoanProductAsync"
                        disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span class="h-4 w-4 animate-spin rounded-full border-2 border-blue-200 border-t-white"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Create Product</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private const string InputClass =
        "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-100";

    private const string TextAreaClass =
        "min-h-32 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-100";

    private List<LoanProductDto> _loanProducts = [];
    private bool _isLoading = true;
    private bool _isCreateModalOpen;
    private bool _isSaving;
    private string? _errorMessage;
    private List<string> _createErrors = [];

    private CreateLoanProductRequest _createModel = new();
    private string _lenderIdText = "11111111-1111-1111-1111-111111111111";

    protected override async Task OnInitializedAsync()
    {
        await LoadLoanProductsAsync();
    }

    private async Task LoadLoanProductsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await LoanProductsApiClient.GetLoanProductsAsync();

            if (response is null)
            {
                _errorMessage = "No response received from the API.";
                return;
            }

            if (!response.Success)
            {
                _errorMessage = response.Errors.Count > 0
                    ? string.Join(", ", response.Errors)
                    : "Failed to load loan products.";
                return;
            }

            _loanProducts = response.Data?.ToList() ?? [];
        }
        catch (Exception exception)
        {
            _errorMessage = $"Unable to load loan products. {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        _createErrors = [];
        _createModel = new CreateLoanProductRequest
        {
            Title = "",
            Description = "",
            MinimumAmount = 1000,
            MaximumAmount = 25000,
            InterestRate = 12.5m,
            MinimumTermMonths = 12,
            MaximumTermMonths = 60
        };

        _lenderIdText = "11111111-1111-1111-1111-111111111111";
        _isCreateModalOpen = true;
    }

    private void CloseCreateModal()
    {
        if (_isSaving)
        {
            return;
        }

        _isCreateModalOpen = false;
    }

    private async Task CreateLoanProductAsync()
    {
        _createErrors = [];

        if (!Guid.TryParse(_lenderIdText, out var lenderId))
        {
            _createErrors.Add("Lender ID must be a valid GUID.");
            return;
        }

        _createModel.LenderId = lenderId;
        _isSaving = true;

        try
        {
            var response = await LoanProductsApiClient.CreateLoanProductAsync(_createModel);

            if (response is null)
            {
                _createErrors.Add("No response received from the API.");
                return;
            }

            if (!response.Success)
            {
                _createErrors = response.Errors.Count > 0
                    ? response.Errors
                    : ["Failed to create loan product."];

                return;
            }

            _isCreateModalOpen = false;
            await LoadLoanProductsAsync();
        }
        catch (Exception exception)
        {
            _createErrors.Add($"Unable to create loan product. {exception.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static string GetStatusClass(string status)
    {
        return status switch
        {
            "Draft" => "inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700",
            "PendingApproval" => "inline-flex rounded-full bg-orange-100 px-3 py-1 text-xs font-semibold text-orange-700",
            "Approved" => "inline-flex rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-700",
            "Published" => "inline-flex rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700",
            "Archived" => "inline-flex rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-700",
            _ => "inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700"
        };
    }
}