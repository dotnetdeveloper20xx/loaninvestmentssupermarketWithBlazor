@page "/admin/users"
@using LoanSuperMarket.Shared.Common
@using LoanSuperMarket.Shared.Users
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject NavigationManager NavigationManager

<PageHeader Title="User Management"
            Subtitle="View and manage all platform users, assign roles, and control account status.">
    <ActionContent>
        <button class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-700"
                @onclick="() => _showCreateModal = true">
            + New User
        </button>
    </ActionContent>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="mb-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
        @_errorMessage
    </div>
}

<!-- Search and Filter Bar -->
<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center">
    <div class="flex-1">
        <input type="text" @bind="_searchTerm" @bind:event="oninput" @onkeyup="HandleSearchKeyUp"
               placeholder="Search by name or email..."
               class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" />
    </div>
    <div>
        <select @bind="_roleFilter" @bind:after="LoadUsersAsync"
                class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500">
            <option value="">All Roles</option>
            <option value="Admin">Admin</option>
            <option value="CrmManager">CRM Manager</option>
            <option value="CustomerService">Customer Service</option>
            <option value="Lender">Lender</option>
            <option value="Borrower">Borrower</option>
            <option value="Auditor">Auditor</option>
        </select>
    </div>
    <button class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50"
            @onclick="LoadUsersAsync">
        Search
    </button>
</div>

<!-- Users Table -->
<div class="rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-6 py-4">
        <h2 class="text-lg font-semibold text-slate-900">Users</h2>
        <p class="mt-1 text-sm text-slate-500">@_totalCount total users</p>
    </div>

    @if (_isLoading)
    {
        <div class="flex items-center justify-center py-12">
            <p class="text-sm text-slate-500">Loading users...</p>
        </div>
    }
    else if (_users.Count == 0)
    {
        <div class="flex flex-col items-center justify-center py-12">
            <span class="text-4xl">👤</span>
            <p class="mt-3 text-sm font-medium text-slate-700">No users found</p>
            <p class="mt-1 text-sm text-slate-500">Try adjusting your search or filter criteria.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="border-b border-slate-200 bg-slate-50">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Name</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Email</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Roles</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Status</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Last Login</th>
                        <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var user in _users)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="px-6 py-4">
                                <div class="font-semibold text-slate-900">@user.FullName</div>
                                <div class="mt-1 text-xs text-slate-500">@user.Id</div>
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-700">@user.Email</td>
                            <td class="px-6 py-4">
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="inline-flex rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700">
                                            @role
                                        </span>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <StatusBadge Status="@user.AccountStatus" />
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-500">
                                @(user.LastLoginAtUtc.HasValue
                                    ? user.LastLoginAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                    : "Never")
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <button class="rounded-lg border border-blue-200 px-3 py-1.5 text-xs font-semibold text-blue-700 hover:bg-blue-50"
                                            @onclick="() => ShowUserDetails(user)">
                                        Details
                                    </button>
                                    <button class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50"
                                            @onclick="() => OpenStatusChangeModal(user)">
                                        Status
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Pagination -->
@if (_totalPages > 1)
{
    <div class="mt-6 flex items-center justify-between">
        <p class="text-sm text-slate-500">
            Page @_currentPage of @_totalPages (@_totalCount total)
        </p>
        <div class="flex gap-2">
            <button disabled="@(_currentPage <= 1)"
                    class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-50"
                    @onclick="PreviousPage">
                Previous
            </button>
            <button disabled="@(_currentPage >= _totalPages)"
                    class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-50"
                    @onclick="NextPage">
                Next
            </button>
        </div>
    </div>
}

<!-- User Details Panel -->
@if (_selectedUser is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" @onclick="CloseDetails">
        <div class="w-full max-w-lg rounded-2xl bg-white p-6 shadow-xl" @onclick:stopPropagation="true">
            <div class="mb-4 flex items-center justify-between">
                <h3 class="text-lg font-semibold text-slate-900">User Details</h3>
                <button class="text-slate-400 hover:text-slate-600" @onclick="CloseDetails">✕</button>
            </div>
            <div class="space-y-4">
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                    <div class="text-sm font-medium text-slate-500">Full Name</div>
                    <div class="mt-1 text-slate-900">@_selectedUser.FullName</div>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                    <div class="text-sm font-medium text-slate-500">Email</div>
                    <div class="mt-1 text-slate-900">@_selectedUser.Email</div>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                    <div class="text-sm font-medium text-slate-500">Roles</div>
                    <div class="mt-1 flex flex-wrap gap-1">
                        @foreach (var role in _selectedUser.Roles)
                        {
                            <span class="inline-flex rounded-full bg-blue-100 px-2.5 py-1 text-xs font-medium text-blue-700">
                                @role
                            </span>
                        }
                    </div>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                    <div class="text-sm font-medium text-slate-500">Account Status</div>
                    <div class="mt-1"><StatusBadge Status="@_selectedUser.AccountStatus" /></div>
                </div>

                <!-- Assign/Remove Role -->
                <div class="rounded-xl border border-slate-200 p-4">
                    <div class="text-sm font-semibold text-slate-700 mb-2">Manage Roles</div>
                    <div class="flex gap-2">
                        <select @bind="_roleToAssign"
                                class="flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm">
                            <option value="">Select role...</option>
                            <option value="Admin">Admin</option>
                            <option value="CrmManager">CRM Manager</option>
                            <option value="CustomerService">Customer Service</option>
                            <option value="Lender">Lender</option>
                            <option value="Borrower">Borrower</option>
                            <option value="Auditor">Auditor</option>
                        </select>
                        <button class="rounded-lg bg-blue-600 px-3 py-2 text-xs font-semibold text-white hover:bg-blue-700"
                                @onclick="AssignRoleAsync">
                            Assign
                        </button>
                        <button class="rounded-lg border border-red-200 px-3 py-2 text-xs font-semibold text-red-700 hover:bg-red-50"
                                @onclick="RemoveRoleAsync">
                            Remove
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Change Status Modal -->
@if (_showStatusModal && _statusChangeUser is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" @onclick="CloseStatusModal">
        <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-xl" @onclick:stopPropagation="true">
            <h3 class="mb-4 text-lg font-semibold text-slate-900">Change Account Status</h3>
            <p class="mb-4 text-sm text-slate-600">Changing status for <strong>@_statusChangeUser.FullName</strong></p>
            <div class="space-y-4">
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">New Status</label>
                    <select @bind="_newStatus"
                            class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm">
                        <option value="Active">Active</option>
                        <option value="Hold">Hold</option>
                        <option value="Blocked">Blocked</option>
                        <option value="Suspended">Suspended</option>
                        <option value="Closed">Closed</option>
                    </select>
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">Reason</label>
                    <textarea @bind="_statusReason" rows="3"
                              class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                              placeholder="Provide a reason for the status change..."></textarea>
                </div>
                <div class="flex justify-end gap-3">
                    <button class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
                            @onclick="CloseStatusModal">
                        Cancel
                    </button>
                    <button class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700"
                            @onclick="ChangeStatusAsync">
                        Confirm
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<UserDto> _users = [];
    private bool _isLoading = true;
    private string? _errorMessage;
    private string _searchTerm = string.Empty;
    private string _roleFilter = string.Empty;
    private int _currentPage = 1;
    private int _pageSize = 20;
    private int _totalCount;
    private int _totalPages;

    // User details panel
    private UserDto? _selectedUser;
    private string _roleToAssign = string.Empty;

    // Status change modal
    private bool _showStatusModal;
    private UserDto? _statusChangeUser;
    private string _newStatus = "Active";
    private string _statusReason = string.Empty;

    // Create user modal
    private bool _showCreateModal;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var url = $"api/users?page={_currentPage}&pageSize={_pageSize}";

            if (!string.IsNullOrWhiteSpace(_searchTerm))
                url += $"&searchTerm={Uri.EscapeDataString(_searchTerm)}";

            if (!string.IsNullOrWhiteSpace(_roleFilter))
                url += $"&roleFilter={Uri.EscapeDataString(_roleFilter)}";

            var response = await Http.GetFromJsonAsync<ApiResponse<PagedResult<UserDto>>>(url);

            if (response is null)
            {
                _errorMessage = "No response received from the API.";
                return;
            }

            if (!response.Success)
            {
                _errorMessage = response.Errors.Count > 0
                    ? string.Join(", ", response.Errors)
                    : "Failed to load users.";
                return;
            }

            var pagedResult = response.Data;
            _users = pagedResult?.Items.ToList() ?? [];
            _totalCount = pagedResult?.TotalCount ?? 0;
            _totalPages = pagedResult?.TotalPages ?? 0;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unable to load users. {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _currentPage = 1;
            await LoadUsersAsync();
        }
    }

    private async Task PreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            await LoadUsersAsync();
        }
    }

    private async Task NextPage()
    {
        if (_currentPage < _totalPages)
        {
            _currentPage++;
            await LoadUsersAsync();
        }
    }

    private void ShowUserDetails(UserDto user)
    {
        _selectedUser = user;
        _roleToAssign = string.Empty;
    }

    private void CloseDetails()
    {
        _selectedUser = null;
    }

    private void OpenStatusChangeModal(UserDto user)
    {
        _statusChangeUser = user;
        _newStatus = "Active";
        _statusReason = string.Empty;
        _showStatusModal = true;
    }

    private void CloseStatusModal()
    {
        _showStatusModal = false;
        _statusChangeUser = null;
    }

    private async Task AssignRoleAsync()
    {
        if (_selectedUser is null || string.IsNullOrWhiteSpace(_roleToAssign))
            return;

        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/users/{_selectedUser.Id}/assign-role",
                new { RoleName = _roleToAssign });

            var result = await response.Content.ReadFromJsonAsync<ApiResponse<string>>();

            if (result?.Success == true)
            {
                _selectedUser = null;
                await LoadUsersAsync();
            }
            else
            {
                _errorMessage = result?.Errors.Count > 0
                    ? string.Join(", ", result.Errors)
                    : "Failed to assign role.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error assigning role. {ex.Message}";
        }
    }

    private async Task RemoveRoleAsync()
    {
        if (_selectedUser is null || string.IsNullOrWhiteSpace(_roleToAssign))
            return;

        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/users/{_selectedUser.Id}/remove-role",
                new { RoleName = _roleToAssign });

            var result = await response.Content.ReadFromJsonAsync<ApiResponse<string>>();

            if (result?.Success == true)
            {
                _selectedUser = null;
                await LoadUsersAsync();
            }
            else
            {
                _errorMessage = result?.Errors.Count > 0
                    ? string.Join(", ", result.Errors)
                    : "Failed to remove role.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error removing role. {ex.Message}";
        }
    }

    private async Task ChangeStatusAsync()
    {
        if (_statusChangeUser is null || string.IsNullOrWhiteSpace(_statusReason))
            return;

        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/users/{_statusChangeUser.Id}/status",
                new { NewStatus = _newStatus, Reason = _statusReason });

            var result = await response.Content.ReadFromJsonAsync<ApiResponse<string>>();

            if (result?.Success == true)
            {
                CloseStatusModal();
                await LoadUsersAsync();
            }
            else
            {
                _errorMessage = result?.Errors.Count > 0
                    ? string.Join(", ", result.Errors)
                    : "Failed to change status.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error changing status. {ex.Message}";
        }
    }
}
