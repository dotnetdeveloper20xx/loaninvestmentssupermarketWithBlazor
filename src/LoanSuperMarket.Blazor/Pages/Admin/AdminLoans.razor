@page "/admin/loans"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject DashboardApiClient DashboardApiClient
@inject NavigationManager Navigation

<PageHeader Title="Admin — All Loans"
            Subtitle="Platform-wide loan operations and monitoring.">
</PageHeader>

@if (_overview is not null)
{
    <div class="grid grid-cols-2 gap-4 md:grid-cols-5 mb-6">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-500 uppercase">Active Loans</div>
            <div class="mt-2 text-lg font-bold text-slate-900">@_overview.TotalActiveLoans</div>
        </div>
        <div class="rounded-2xl border border-red-200 bg-red-50 p-5 shadow-sm">
            <div class="text-xs font-semibold text-red-600 uppercase">Defaulted</div>
            <div class="mt-2 text-lg font-bold text-red-700">@_overview.TotalDefaultedLoans</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-500 uppercase">Outstanding</div>
            <div class="mt-2 text-lg font-bold text-slate-900">£@_overview.TotalOutstandingPrincipal.ToString("N0")</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-500 uppercase">Total Funded</div>
            <div class="mt-2 text-lg font-bold text-slate-900">£@_overview.TotalFundedAllTime.ToString("N0")</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-500 uppercase">Default Rate</div>
            <div class="mt-2 text-lg font-bold @(_overview.PlatformDefaultRate > 5 ? "text-red-600" : "text-green-700")">
                @_overview.PlatformDefaultRate.ToString("N1")%
            </div>
        </div>
    </div>

    <div class="mb-4 flex flex-wrap items-end gap-4">
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Performance</label>
            <select @bind="_performanceFilter"
                    class="rounded-lg border border-slate-300 px-3 py-2 text-sm">
                <option value="">All</option>
                <option value="OnTime">On Time</option>
                <option value="Late">Late</option>
                <option value="Defaulted">Defaulted</option>
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Lender</label>
            <input type="text" @bind="_lenderFilter"
                   placeholder="Filter by lender..."
                   class="rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        </div>
        <button class="rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700"
                @onclick="LoadDataAsync">
            Apply
        </button>
    </div>

    @if (_overview.Loans.Count == 0)
    {
        <div class="py-8 text-center text-slate-500">No loans match the current filters.</div>
    }
    else
    {
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-sm">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase text-slate-500">Lender</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase text-slate-500">Borrower</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-slate-500">Amount</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-slate-500">Rate</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-slate-500">Term</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold uppercase text-slate-500">Performance</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold uppercase text-slate-500">Progress</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase text-slate-500">Funded</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-slate-500">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var loan in _overview.Loans)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="px-4 py-3 text-slate-900">@loan.LenderName</td>
                            <td class="px-4 py-3 text-slate-700">@loan.BorrowerName</td>
                            <td class="px-4 py-3 text-right font-semibold">£@loan.FundedAmount.ToString("N0")</td>
                            <td class="px-4 py-3 text-right">@loan.EffectiveRate.ToString("N2")%</td>
                            <td class="px-4 py-3 text-right">@loan.TermMonths mo</td>
                            <td class="px-4 py-3 text-center">
                                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold
                                    @(loan.Performance == "OnTime" ? "bg-green-100 text-green-800" :
                                      loan.Performance == "Late" ? "bg-amber-100 text-amber-800" :
                                      "bg-red-100 text-red-800")">
                                    @loan.Performance
                                </span>
                            </td>
                            <td class="px-4 py-3 text-center text-xs">@loan.PaidInstallments/@loan.TotalInstallments</td>
                            <td class="px-4 py-3 text-slate-500 text-xs">@loan.FundedDate.ToString("dd MMM yyyy")</td>
                            <td class="px-4 py-3 text-right">
                                <button class="text-xs text-blue-600 hover:underline"
                                        @onclick="() => ViewSchedule(loan.ScheduleId)">
                                    View
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else
{
    <div class="py-12 text-center text-slate-500">Loading...</div>
}

@code {
    private AdminLoansOverviewDto? _overview;
    private string? _performanceFilter;
    private string? _lenderFilter;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var queryParams = new List<string>();
        if (!string.IsNullOrWhiteSpace(_performanceFilter))
            queryParams.Add($"performance={Uri.EscapeDataString(_performanceFilter)}");
        if (!string.IsNullOrWhiteSpace(_lenderFilter))
            queryParams.Add($"lender={Uri.EscapeDataString(_lenderFilter)}");

        var url = "api/dashboard/admin/loans";
        if (queryParams.Count > 0)
            url += "?" + string.Join("&", queryParams);

        // Use the HttpClient directly for this admin endpoint
        try
        {
            var response = await DashboardApiClient.GetAdminLoansOverviewAsync(
                _performanceFilter, _lenderFilter);
            if (response?.Success == true)
            {
                _overview = response.Data;
            }
        }
        catch { }
    }

    private void ViewSchedule(Guid scheduleId)
    {
        Navigation.NavigateTo($"/repayment-schedule/{scheduleId}");
    }
}
