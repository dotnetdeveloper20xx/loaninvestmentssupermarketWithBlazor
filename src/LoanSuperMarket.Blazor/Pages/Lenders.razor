@page "/lenders"
@inject LendersApiClient LendersApiClient
@inject DrawerService DrawerService

<PageHeader Title="Lenders"
            Subtitle="Manage lender profiles, verification status and available funding capacity.">
    <ActionContent>
        <button class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-700"
                @onclick="OpenCreateModal">
            + New Lender
        </button>
    </ActionContent>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="mb-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
        @_errorMessage
    </div>
}

<DataGridToolbar State="_gridState"
                 SearchLabel="Search lenders"
                 SearchPlaceholder="Search by company, contact, email or phone..."
                 VisibleCount="PagedLenders.Count"
                 TotalCount="_lenders.Count"
                 StatusOptions="_statusOptions"
                 OnStateChanged="HandleGridStateChanged" />

<AppDataTable Title="Lender Management"
              Subtitle="Operational lender list for verification and funding workflows."
              IsLoading="_isLoading"
              IsEmpty="@(!_isLoading && FilteredLenders.Count == 0)"
              LoadingText="Loading lenders..."
              EmptyIcon="💼"
              EmptyTitle="No lenders found"
              EmptyMessage="No lenders match the current search or filter criteria.">

    <HeaderActions>
        <button class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50"
                @onclick="LoadLendersAsync">
            Refresh
        </button>
    </HeaderActions>

    <EmptyActions>
        @if (_lenders.Count == 0)
        {
            <button class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-700"
                    @onclick="OpenCreateModal">
                Create Lender
            </button>
        }
        else
        {
            <button class="rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50"
                    @onclick="ClearFilters">
                Clear Filters
            </button>
        }
    </EmptyActions>

    <HeaderTemplate>
        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
            <DataGridColumnHeader State="_gridState"
                                  Column="CompanyName"
                                  Title="Lender"
                                  OnSortChanged="HandleGridStateChanged" />
        </th>

        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
            <DataGridColumnHeader State="_gridState"
                                  Column="Email"
                                  Title="Contact"
                                  OnSortChanged="HandleGridStateChanged" />
        </th>

        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
            <DataGridColumnHeader State="_gridState"
                                  Column="AvailableFunds"
                                  Title="Available Funds"
                                  OnSortChanged="HandleGridStateChanged" />
        </th>

        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
            <DataGridColumnHeader State="_gridState"
                                  Column="Status"
                                  Title="Status"
                                  OnSortChanged="HandleGridStateChanged" />
        </th>

        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
            <DataGridColumnHeader State="_gridState"
                                  Column="CreatedAtUtc"
                                  Title="Created"
                                  OnSortChanged="HandleGridStateChanged" />
        </th>

        <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">
            Actions
        </th>
    </HeaderTemplate>

    <RowTemplate>
        @foreach (var lender in PagedLenders)
        {
            <tr class="hover:bg-slate-50">
                <td class="px-6 py-4">
                    <div class="font-semibold text-slate-900">@lender.CompanyName</div>
                    <div class="mt-1 text-sm text-slate-500">@lender.ContactName</div>
                </td>

                <td class="px-6 py-4">
                    <div class="text-sm font-medium text-slate-900">@lender.Email</div>
                    <div class="mt-1 text-sm text-slate-500">@lender.PhoneNumber</div>
                </td>

                <td class="px-6 py-4 text-sm font-semibold text-slate-900">
                    £@lender.AvailableFunds.ToString("N0")
                </td>

                <td class="px-6 py-4">
                    <StatusBadge Status="@lender.Status" />
                </td>

                <td class="px-6 py-4 text-sm text-slate-500">
                    @lender.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")
                </td>
                <td class="px-6 py-4 text-right">
                    <button class="rounded-lg border border-blue-200 px-3 py-2 text-xs font-semibold text-blue-700 hover:bg-blue-50"
                            @onclick="() => OpenLenderDrawer(lender)">
                        Quick View
                    </button>
                </td>
            </tr>
        }
    </RowTemplate>
</AppDataTable>

<DataGridPager State="_gridState"
               TotalCount="FilteredLenders.Count"
               OnPageChanged="HandleGridStateChanged" />

<CreateLenderModal IsOpen="_isCreateModalOpen"
                   OnClose="CloseCreateModal"
                   OnCreated="HandleLenderCreated" />

@code {
    private readonly GridState _gridState = new();

    private readonly IReadOnlyList<DataGridToolbar.DataGridStatusOption> _statusOptions =
    [
        new("PendingVerification", "Pending Verification"),
        new("Verified", "Verified"),
        new("Suspended", "Suspended"),
        new("Archived", "Archived")
    ];

    private List<LenderDto> _lenders = [];
    private bool _isLoading = true;
    private bool _isCreateModalOpen;
    private string? _errorMessage;

    private List<LenderDto> FilteredLenders
    {
        get
        {
            var query = _lenders.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_gridState.SearchText))
            {
                query = query.Where(lender =>
                    lender.CompanyName.Contains(_gridState.SearchText, StringComparison.OrdinalIgnoreCase)
                    || lender.ContactName.Contains(_gridState.SearchText, StringComparison.OrdinalIgnoreCase)
                    || lender.Email.Contains(_gridState.SearchText, StringComparison.OrdinalIgnoreCase)
                    || lender.PhoneNumber.Contains(_gridState.SearchText, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_gridState.SelectedStatus))
            {
                query = query.Where(lender =>
                    lender.Status.Equals(_gridState.SelectedStatus, StringComparison.OrdinalIgnoreCase));
            }

            query = (_gridState.SortColumn, _gridState.SortAscending) switch
            {
                ("CompanyName", true) => query.OrderBy(lender => lender.CompanyName),
                ("CompanyName", false) => query.OrderByDescending(lender => lender.CompanyName),

                ("Email", true) => query.OrderBy(lender => lender.Email),
                ("Email", false) => query.OrderByDescending(lender => lender.Email),

                ("AvailableFunds", true) => query.OrderBy(lender => lender.AvailableFunds),
                ("AvailableFunds", false) => query.OrderByDescending(lender => lender.AvailableFunds),

                ("Status", true) => query.OrderBy(lender => lender.Status),
                ("Status", false) => query.OrderByDescending(lender => lender.Status),

                ("CreatedAtUtc", true) => query.OrderBy(lender => lender.CreatedAtUtc),
                ("CreatedAtUtc", false) => query.OrderByDescending(lender => lender.CreatedAtUtc),

                _ => query.OrderByDescending(lender => lender.CreatedAtUtc)
            };

            return query.ToList();
        }
    }

    private List<LenderDto> PagedLenders =>
        FilteredLenders
            .Skip((_gridState.PageNumber - 1) * _gridState.PageSize)
            .Take(_gridState.PageSize)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadLendersAsync();
    }

    private async Task LoadLendersAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await LendersApiClient.GetLendersAsync();

            if (response is null)
            {
                _errorMessage = "No response received from the API.";
                return;
            }

            if (!response.Success)
            {
                _errorMessage = response.Errors.Count > 0
                    ? string.Join(", ", response.Errors)
                    : "Failed to load lenders.";

                return;
            }

            _lenders = response.Data?.ToList() ?? [];
        }
        catch (Exception exception)
        {
            _errorMessage = $"Unable to load lenders. {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task HandleGridStateChanged()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void OpenCreateModal()
    {
        _isCreateModalOpen = true;
    }

    private void CloseCreateModal()
    {
        _isCreateModalOpen = false;
    }

    private async Task HandleLenderCreated()
    {
        await LoadLendersAsync();
    }

    private void ClearFilters()
    {
        _gridState.ClearFilters();
    }
    private void OpenLenderDrawer(LenderDto lender)
    {
        DrawerService.Open(new DrawerRequest
        {
            Title = lender.CompanyName,
            Subtitle = "Lender quick view",
            Content = builder =>
            {
                var sequence = 0;

                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "space-y-6");

                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "rounded-2xl border border-slate-200 bg-slate-50 p-5");
                builder.AddMarkupContent(sequence++, $"<div class='text-sm font-semibold text-slate-500'>Contact Name</div><div class='mt-1 text-slate-900'>{lender.ContactName}</div>");
                builder.CloseElement();

                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "rounded-2xl border border-slate-200 bg-slate-50 p-5");
                builder.AddMarkupContent(sequence++, $"<div class='text-sm font-semibold text-slate-500'>Email</div><div class='mt-1 text-slate-900'>{lender.Email}</div>");
                builder.CloseElement();

                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "rounded-2xl border border-slate-200 bg-slate-50 p-5");
                builder.AddMarkupContent(sequence++, $"<div class='text-sm font-semibold text-slate-500'>Phone</div><div class='mt-1 text-slate-900'>{lender.PhoneNumber}</div>");
                builder.CloseElement();

                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "rounded-2xl border border-slate-200 bg-slate-50 p-5");
                builder.AddMarkupContent(sequence++, $"<div class='text-sm font-semibold text-slate-500'>Available Funds</div><div class='mt-1 text-slate-900'>£{lender.AvailableFunds:N0}</div>");
                builder.CloseElement();

                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "rounded-2xl border border-slate-200 bg-slate-50 p-5");
                builder.AddMarkupContent(sequence++, $"<div class='text-sm font-semibold text-slate-500'>Status</div><div class='mt-1 text-slate-900'>{lender.Status}</div>");
                builder.CloseElement();

                builder.CloseElement();
            }
        });
    }
}