@implements IDisposable
@inject ToastService ToastService

@if (ToastService.Messages.Count > 0)
{
    <div class="fixed right-6 top-6 z-[100] flex w-full max-w-sm flex-col gap-3">
        @foreach (var toast in ToastService.Messages)
        {
            <div @key="toast.Id" class="@GetToastClass(toast)">
                <div class="flex items-start gap-3">
                    <div class="text-xl">
                        @GetIcon(toast.Level)
                    </div>

                    <div class="min-w-0 flex-1">
                        <div class="text-sm font-bold">
                            @toast.Title
                        </div>

                        <div class="mt-1 text-sm opacity-90">
                            @toast.Message
                        </div>
                    </div>

                    <button type="button"
                            class="rounded-lg p-1 text-sm opacity-70 transition hover:bg-black/5 hover:opacity-100"
                            @onclick="() => RemoveToast(toast.Id)">
                        ✕
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    protected override void OnInitialized()
    {
        ToastService.OnChange += HandleToastChanged;
    }

    private void HandleToastChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void RemoveToast(Guid id)
    {
        ToastService.Remove(id);
    }

    private static string GetToastClass(ToastMessage toast)
    {
        var baseClass =
            "rounded-2xl border p-4 shadow-lg transition-all duration-300 ease-in-out " +
            "transform " +
            (toast.IsClosing
                ? "opacity-0 translate-x-6 scale-95"
                : "opacity-100 translate-x-0 scale-100");

        var colorClass = toast.Level switch
        {
            ToastLevel.Success =>
                " border-green-200 bg-green-50 text-green-800",

            ToastLevel.Error =>
                " border-red-200 bg-red-50 text-red-800",

            ToastLevel.Warning =>
                " border-amber-200 bg-amber-50 text-amber-800",

            _ =>
                " border-blue-200 bg-blue-50 text-blue-800"
        };

        return baseClass + colorClass;
    }

    private static string GetIcon(ToastLevel level)
    {
        return level switch
        {
            ToastLevel.Success => "✅",
            ToastLevel.Error => "❌",
            ToastLevel.Warning => "⚠️",
            _ => "ℹ️"
        };
    }

    public void Dispose()
    {
        ToastService.OnChange -= HandleToastChanged;
    }
}