@using LoanSuperMarket.Shared.Audit
@inject DashboardApiClient DashboardApiClient

<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="text-sm font-semibold text-slate-700 mb-4">Recent Activity</h3>

    @if (_logs.Count == 0)
    {
        <div class="py-4 text-center text-sm text-slate-400">No recent activity.</div>
    }
    else
    {
        <div class="space-y-3">
            @foreach (var log in _logs.Take(8))
            {
                <div class="flex items-start gap-3">
                    <div class="mt-1 h-2 w-2 rounded-full flex-shrink-0 @GetDotColor(log.Action)"></div>
                    <div class="flex-1 min-w-0">
                        <div class="text-sm text-slate-700 truncate">@log.Description</div>
                        <div class="text-xs text-slate-400 mt-0.5">
                            @log.OccurredAtUtc.ToLocalTime().ToString("dd MMM HH:mm") · @log.PerformedBy
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string EntityName { get; set; } = "LoanApplication";
    [Parameter] public Guid? EntityId { get; set; }

    private List<AuditLogDto> _logs = [];

    protected override async Task OnInitializedAsync()
    {
        if (EntityId.HasValue && EntityId.Value != Guid.Empty)
        {
            var response = await DashboardApiClient.GetAuditTrailAsync(EntityName, EntityId.Value);
            if (response?.Success == true)
            {
                _logs = response.Data?.ToList() ?? [];
            }
        }
    }

    private static string GetDotColor(string action) => action switch
    {
        "Funded" => "bg-green-500",
        "FundingDeclined" => "bg-red-500",
        "FundsTopUp" => "bg-blue-500",
        "Approved" => "bg-emerald-500",
        "Rejected" => "bg-red-400",
        "Restructured" => "bg-purple-500",
        "LateFeeApplied" => "bg-amber-500",
        _ => "bg-slate-400"
    };
}
