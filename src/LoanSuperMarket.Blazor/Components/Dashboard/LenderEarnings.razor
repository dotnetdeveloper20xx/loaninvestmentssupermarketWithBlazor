@inject DashboardApiClient DashboardApiClient

@if (_earnings is not null)
{
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-500 uppercase">Interest Received</div>
            <div class="mt-2 text-lg font-bold text-green-700">£@_earnings.TotalInterestReceived.ToString("N2")</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-500 uppercase">Projected Returns</div>
            <div class="mt-2 text-lg font-bold text-slate-900">£@_earnings.ProjectedTotalReturns.ToString("N2")</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-500 uppercase">Late Fees Collected</div>
            <div class="mt-2 text-lg font-bold text-amber-700">£@_earnings.TotalLateFeesCollected.ToString("N2")</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-500 uppercase">Available Funds</div>
            <div class="mt-2 text-lg font-bold text-blue-700">£@_earnings.AvailableFunds.ToString("N0")</div>
        </div>
    </div>
}

@code {
    private LenderEarningsDto? _earnings;

    protected override async Task OnInitializedAsync()
    {
        var response = await DashboardApiClient.GetLenderEarningsAsync();
        if (response?.Success == true)
        {
            _earnings = response.Data;
        }
    }
}
