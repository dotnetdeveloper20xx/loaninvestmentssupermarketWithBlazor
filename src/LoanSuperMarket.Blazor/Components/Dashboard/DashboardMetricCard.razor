<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-start justify-between">
        <div>
            <p class="text-sm font-medium text-slate-500">
                @Title
            </p>

            <p class="mt-3 text-3xl font-bold tracking-tight text-slate-900">
                @Value
            </p>

            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="mt-2 text-sm text-slate-500">
                    @Description
                </p>
            }
        </div>

        <div class="@IconContainerClass">
            <span class="text-xl">@Icon</span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Trend))
    {
        <div class="mt-4">
            <span class="@TrendClass">
                @Trend
            </span>
        </div>
    }
</div>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string Icon { get; set; } = "📊";

    [Parameter]
    public string Colour { get; set; } = "blue";

    [Parameter]
    public string? Trend { get; set; }

    private string IconContainerClass => Colour switch
    {
        "green" => "rounded-xl bg-green-50 p-3 text-green-600",
        "orange" => "rounded-xl bg-orange-50 p-3 text-orange-600",
        "red" => "rounded-xl bg-red-50 p-3 text-red-600",
        "purple" => "rounded-xl bg-purple-50 p-3 text-purple-600",
        _ => "rounded-xl bg-blue-50 p-3 text-blue-600"
    };

    private string TrendClass => Colour switch
    {
        "green" => "badge badge-success badge-outline",
        "orange" => "badge badge-warning badge-outline",
        "red" => "badge badge-error badge-outline",
        "purple" => "badge badge-secondary badge-outline",
        _ => "badge badge-info badge-outline"
    };
}