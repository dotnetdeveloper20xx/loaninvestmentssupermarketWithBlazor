@inject DashboardApiClient DashboardApiClient

@if (_analytics is not null)
{
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4 mb-6">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-500 uppercase">Total Invested</div>
            <div class="mt-2 text-lg font-bold text-slate-900">£@_analytics.TotalInvested.ToString("N0")</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-500 uppercase">Net Profit</div>
            <div class="mt-2 text-lg font-bold @(_analytics.NetProfit >= 0 ? "text-green-700" : "text-red-600")">
                £@_analytics.NetProfit.ToString("N2")
            </div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-500 uppercase">Annualized Yield</div>
            <div class="mt-2 text-lg font-bold text-blue-700">@_analytics.AnnualizedYield.ToString("N2")%</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-500 uppercase">Avg ROI per Loan</div>
            <div class="mt-2 text-lg font-bold text-purple-700">@_analytics.AverageRoi.ToString("N2")%</div>
        </div>
    </div>

    <div class="grid grid-cols-2 gap-4 md:grid-cols-4 mb-6">
        <div class="rounded-2xl border border-green-200 bg-green-50 p-4 text-center">
            <div class="text-2xl font-bold text-green-700">@_analytics.PerformingLoans</div>
            <div class="text-xs text-green-600 mt-1">Performing</div>
        </div>
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4 text-center">
            <div class="text-2xl font-bold text-amber-700">@_analytics.LateLoans</div>
            <div class="text-xs text-amber-600 mt-1">Late</div>
        </div>
        <div class="rounded-2xl border border-red-200 bg-red-50 p-4 text-center">
            <div class="text-2xl font-bold text-red-700">@_analytics.DefaultedLoans</div>
            <div class="text-xs text-red-600 mt-1">Defaulted</div>
        </div>
        <div class="rounded-2xl border border-blue-200 bg-blue-50 p-4 text-center">
            <div class="text-2xl font-bold text-blue-700">@_analytics.DiversificationScore.ToString("N0")%</div>
            <div class="text-xs text-blue-600 mt-1">Diversification</div>
        </div>
    </div>

    @if (_analytics.LoanBreakdown.Count > 0)
    {
        <h4 class="text-sm font-semibold text-slate-700 mb-3">ROI per Loan</h4>
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-sm">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase text-slate-500">Borrower</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-slate-500">Funded</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-slate-500">Interest</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-slate-500">Late Fees</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-slate-500">ROI</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold uppercase text-slate-500">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var loan in _analytics.LoanBreakdown)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="px-4 py-3 font-medium text-slate-900">@loan.BorrowerName</td>
                            <td class="px-4 py-3 text-right">£@loan.FundedAmount.ToString("N0")</td>
                            <td class="px-4 py-3 text-right text-green-700">£@loan.InterestEarned.ToString("N2")</td>
                            <td class="px-4 py-3 text-right text-amber-700">£@loan.LateFeesEarned.ToString("N2")</td>
                            <td class="px-4 py-3 text-right font-semibold">@loan.RoiPercentage.ToString("N2")%</td>
                            <td class="px-4 py-3 text-center">
                                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold
                                    @(loan.Performance == "OnTime" ? "bg-green-100 text-green-800" :
                                      loan.Performance == "Late" ? "bg-amber-100 text-amber-800" :
                                      "bg-red-100 text-red-800")">
                                    @loan.Performance
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else
{
    <div class="py-8 text-center text-slate-500">Loading analytics...</div>
}

@code {
    private InvestorAnalyticsDto? _analytics;

    protected override async Task OnInitializedAsync()
    {
        var response = await DashboardApiClient.GetInvestorAnalyticsAsync();
        if (response?.Success == true)
        {
            _analytics = response.Data;
        }
    }
}
