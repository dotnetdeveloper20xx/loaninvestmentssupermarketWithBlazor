@inject DashboardApiClient DashboardApiClient
@inject NavigationManager Navigation

<div class="mb-4 flex items-center gap-4">
    <select @bind="_performanceFilter" @bind:after="LoadLoansAsync"
            class="rounded-lg border border-slate-300 px-3 py-2 text-sm">
        <option value="">All Performance</option>
        <option value="OnTime">On Time</option>
        <option value="Late">Late</option>
        <option value="Defaulted">Defaulted</option>
    </select>
</div>

@if (_loans.Count == 0)
{
    <div class="py-8 text-center text-slate-500">No funded loans found.</div>
}
else
{
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-sm">
            <thead class="bg-slate-50 border-b border-slate-200">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase text-slate-500">Borrower</th>
                    <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-slate-500">Amount</th>
                    <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-slate-500">Term</th>
                    <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-slate-500">Rate</th>
                    <th class="px-4 py-3 text-center text-xs font-semibold uppercase text-slate-500">Performance</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase text-slate-500">Next Due</th>
                    <th class="px-4 py-3 text-right text-xs font-semibold uppercase text-slate-500">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var loan in _loans)
                {
                    <tr class="hover:bg-slate-50">
                        <td class="px-4 py-3 font-medium text-slate-900">@loan.BorrowerName</td>
                        <td class="px-4 py-3 text-right font-semibold">£@loan.FundedAmount.ToString("N0")</td>
                        <td class="px-4 py-3 text-right">@loan.TermMonths mo</td>
                        <td class="px-4 py-3 text-right">@loan.EffectiveRate.ToString("N2")%</td>
                        <td class="px-4 py-3 text-center">
                            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold
                                @(loan.Performance == "OnTime" ? "bg-green-100 text-green-800" :
                                  loan.Performance == "Late" ? "bg-amber-100 text-amber-800" :
                                  "bg-red-100 text-red-800")">
                                @loan.Performance
                            </span>
                        </td>
                        <td class="px-4 py-3 text-slate-700">
                            @(loan.NextDueDate?.ToString("dd MMM yyyy") ?? "—")
                        </td>
                        <td class="px-4 py-3 text-right">
                            <button class="text-xs text-blue-600 hover:underline"
                                    @onclick="() => NavigateToSchedule(loan.ScheduleId)">
                                View
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<LenderLoanDto> _loans = [];
    private string? _performanceFilter;

    protected override async Task OnInitializedAsync()
    {
        await LoadLoansAsync();
    }

    private async Task LoadLoansAsync()
    {
        var response = await DashboardApiClient.GetLenderLoansAsync(_performanceFilter);
        if (response?.Success == true)
        {
            _loans = response.Data?.ToList() ?? [];
        }
    }

    private void NavigateToSchedule(Guid scheduleId)
    {
        Navigation.NavigateTo($"/repayment-schedule/{scheduleId}");
    }
}
