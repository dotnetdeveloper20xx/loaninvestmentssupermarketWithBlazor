@inject DashboardApiClient DashboardApiClient

@if (_portfolio is not null)
{
    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-6">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-500 uppercase">Total Funded</div>
            <div class="mt-2 text-lg font-bold text-slate-900">£@_portfolio.TotalFunded.ToString("N0")</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-500 uppercase">Active Loans</div>
            <div class="mt-2 text-lg font-bold text-slate-900">@_portfolio.ActiveLoanCount</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-500 uppercase">Outstanding</div>
            <div class="mt-2 text-lg font-bold text-slate-900">£@_portfolio.OutstandingPrincipal.ToString("N0")</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-500 uppercase">Monthly Income</div>
            <div class="mt-2 text-lg font-bold text-green-700">£@_portfolio.ExpectedMonthlyIncome.ToString("N0")</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-500 uppercase">Default Rate</div>
            <div class="mt-2 text-lg font-bold @(_portfolio.DefaultRate > 0 ? "text-red-600" : "text-green-700")">
                @_portfolio.DefaultRate.ToString("N1")%
            </div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="text-xs font-semibold text-slate-500 uppercase">Available Funds</div>
            <div class="mt-2 text-lg font-bold text-blue-700">£@_portfolio.AvailableFunds.ToString("N0")</div>
        </div>
    </div>
}

@code {
    private LenderPortfolioDto? _portfolio;

    protected override async Task OnInitializedAsync()
    {
        var response = await DashboardApiClient.GetLenderPortfolioAsync();
        if (response?.Success == true)
        {
            _portfolio = response.Data;
        }
    }
}
