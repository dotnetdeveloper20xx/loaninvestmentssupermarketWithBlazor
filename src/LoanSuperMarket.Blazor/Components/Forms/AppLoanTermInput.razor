<div class="@WrapperClass">
    <label class="mb-2 block text-sm font-semibold text-slate-700">
        @Label
        @if (Required)
        {
            <span class="text-red-500">*</span>
        }
    </label>

    <div class="flex gap-2">
        <div class="flex-1">
            <input type="number"
                   class="@GetInputClass()"
                   placeholder="@Placeholder"
                   value="@GetDisplayValue()"
                   min="@GetMinDisplay()"
                   max="@GetMaxDisplay()"
                   @oninput="HandleInput"
                   @onblur="HandleBlur" />
        </div>

        <select class="w-28 rounded-xl border border-slate-300 bg-white px-3 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100"
                value="@_selectedUnit"
                @onchange="HandleUnitChange">
            @foreach (var unit in AllowedUnits)
            {
                <option value="@unit">@unit</option>
            }
        </select>
    </div>

    @if (ShowConversion && Value > 0)
    {
        <p class="mt-1 text-xs text-slate-600">≈ @GetConversionText()</p>
    }

    @if (ShowValidationSummary && !string.IsNullOrEmpty(_validationMessage))
    {
        <p class="mt-2 text-sm text-red-600">@_validationMessage</p>
    }

    @if (ShowRangeInfo)
    {
        <p class="mt-1 text-xs text-slate-500">Range: @GetRangeText()</p>
    }

    @if (ValueExpression is not null)
    {
        <ValidationMessage For="@ValueExpression" class="mt-2 text-sm text-red-600" />
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Placeholder { get; set; } = "0";
    [Parameter] public string WrapperClass { get; set; } = string.Empty;
    [Parameter] public bool Required { get; set; }
    [Parameter] public string[] AllowedUnits { get; set; } = new[] { "months", "years" };
    [Parameter] public int MinMonths { get; set; } = 1;
    [Parameter] public int MaxMonths { get; set; } = 360;
    [Parameter] public bool ShowRangeInfo { get; set; } = true;
    [Parameter] public bool ShowValidationSummary { get; set; } = true;
    [Parameter] public bool ShowConversion { get; set; } = true;

    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public Expression<Func<int>>? ValueExpression { get; set; }

    private string _selectedUnit = "months";
    private string _validationMessage = string.Empty;

    protected override void OnInitialized()
    {
        _selectedUnit = AllowedUnits.FirstOrDefault() ?? "months";
    }

    private string GetInputClass()
    {
        var baseClass = "w-full rounded-xl border bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:ring-4";
        if (!string.IsNullOrEmpty(_validationMessage))
            return $"{baseClass} border-red-300 focus:border-red-500 focus:ring-red-100";
        return $"{baseClass} border-slate-300 focus:border-blue-500 focus:ring-blue-100";
    }

    private int GetDisplayValue() => _selectedUnit == "years" ? (int)Math.Round(Value / 12.0) : Value;
    private int GetMinDisplay() => _selectedUnit == "years" ? (int)Math.Ceiling(MinMonths / 12.0) : MinMonths;
    private int GetMaxDisplay() => _selectedUnit == "years" ? (int)Math.Floor(MaxMonths / 12.0) : MaxMonths;

    private string GetConversionText() => _selectedUnit switch
    {
        "years" => $"{Value} months",
        "months" => Value >= 12 ? $"{Value / 12.0:F1} years" : $"{Value} months",
        _ => string.Empty
    };

    private string GetRangeText()
    {
        if (_selectedUnit == "years")
            return $"{GetMinDisplay()} – {GetMaxDisplay()} years";
        return $"{MinMonths} – {MaxMonths} months";
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var input))
        {
            var months = _selectedUnit == "years" ? input * 12 : input;
            _validationMessage = Validate(months);
            await SetValue(months);
        }
        else
        {
            _validationMessage = "Please enter a valid number";
        }
    }

    private void HandleBlur(FocusEventArgs e) { }

    private async Task HandleUnitChange(ChangeEventArgs e)
    {
        _selectedUnit = e.Value?.ToString() ?? "months";
        await Task.CompletedTask;
    }

    private string Validate(int months)
    {
        if (Required && months == 0) return $"{Label} is required";
        if (months < MinMonths) return $"Must be at least {MinMonths} months";
        if (months > MaxMonths) return $"Cannot exceed {MaxMonths} months";
        return string.Empty;
    }

    private async Task SetValue(int value)
    {
        if (Value != value)
        {
            Value = value;
            await ValueChanged.InvokeAsync(value);
        }
    }
}
