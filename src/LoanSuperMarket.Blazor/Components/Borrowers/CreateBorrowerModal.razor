@inject BorrowersApiClient BorrowersApiClient
@inject ToastService ToastService

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 px-4 backdrop-blur-sm">
        <div class="max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-2xl bg-white p-8 shadow-2xl">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h3 class="text-2xl font-bold text-slate-900">Create Borrower</h3>
                    <p class="mt-2 text-sm text-slate-500">
                        Add a borrower profile ready for verification and future loan applications.
                    </p>
                </div>

                <button type="button"
                        class="rounded-full p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700"
                        @onclick="CloseAsync">
                    ✕
                </button>
            </div>

            @if (_apiErrors.Count > 0)
            {
                <div class="mt-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                    <strong>Unable to create borrower</strong>
                    <ul class="mt-2 list-disc pl-5">
                        @foreach (var error in _apiErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            <EditForm Model="_model" OnValidSubmit="CreateAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="mt-6 rounded-2xl border border-orange-200 bg-orange-50 p-4 text-sm text-orange-700" />

                <FormSection>
                    <AppTextInput Label="First name"
                                  Value="@_model.FirstName"
                                  ValueChanged="value => _model.FirstName = value"
                                  ValueExpression="@(() => _model.FirstName)" />

                    <AppTextInput Label="Last name"
                                  Value="@_model.LastName"
                                  ValueChanged="value => _model.LastName = value"
                                  ValueExpression="@(() => _model.LastName)" />

                    <AppTextInput Label="Email"
                                  WrapperClass="md:col-span-2"
                                  Value="@_model.Email"
                                  ValueChanged="value => _model.Email = value"
                                  ValueExpression="@(() => _model.Email)" />

                    <AppTextInput Label="Phone number"
                                  Value="@_model.PhoneNumber"
                                  ValueChanged="value => _model.PhoneNumber = value"
                                  ValueExpression="@(() => _model.PhoneNumber)" />

                    <AppDateInput Label="Date of birth"
                                  Value="@_model.DateOfBirth"
                                  ValueChanged="value => _model.DateOfBirth = value"
                                  ValueExpression="@(() => _model.DateOfBirth)" />
                </FormSection>

                <FormActions IsSaving="_isSaving"
                             SubmitText="Create Borrower"
                             SavingText="Saving..."
                             OnCancel="CloseAsync" />
            </EditForm>
        </div>
    </div>
}

@code {
    private const string InputClass =
        "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-100";

    private readonly List<string> _apiErrors = [];
    private CreateBorrowerRequest _model = new();
    private bool _isSaving;

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnCreated { get; set; }

    protected override void OnParametersSet()
    {
        if (IsOpen && string.IsNullOrWhiteSpace(_model.FirstName) && !_isSaving)
        {
            ResetForm();
        }
    }

    private void ResetForm()
    {
        _apiErrors.Clear();

        _model = new CreateBorrowerRequest
        {
            DateOfBirth = DateTime.Today.AddYears(-25)
        };
    }

    private async Task CloseAsync()
    {
        if (_isSaving)
        {
            return;
        }

        await OnClose.InvokeAsync();
    }

    private async Task CreateAsync()
    {
        _apiErrors.Clear();
        _isSaving = true;

        try
        {
            var response = await BorrowersApiClient.CreateBorrowerAsync(_model);

            if (response is null)
            {
                const string errorMessage = "No response received from the API.";

                _apiErrors.Add(errorMessage);

                ToastService.ShowError(
                    "Borrower creation failed",
                    errorMessage);

                return;
            }

            if (!response.Success)
            {
                var errorMessage = response.Errors.Count > 0
                    ? string.Join(", ", response.Errors)
                    : "Failed to create borrower.";

                _apiErrors.Add(errorMessage);

                ToastService.ShowError(
                    "Borrower creation failed",
                    errorMessage);

                return;
            }

            ToastService.ShowSuccess(
                "Borrower created",
                "Borrower profile has been created successfully.");

            ResetForm();

            await OnCreated.InvokeAsync();
            await OnClose.InvokeAsync();
        }
        catch (Exception exception)
        {
            var errorMessage = $"Unable to create borrower. {exception.Message}";

            _apiErrors.Add(errorMessage);

            ToastService.ShowError(
                "Borrower creation failed",
                errorMessage);
        }
        finally
        {
            _isSaving = false;
        }
    }
}