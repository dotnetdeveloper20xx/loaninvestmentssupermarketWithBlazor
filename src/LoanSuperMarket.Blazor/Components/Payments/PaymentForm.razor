@inject PaymentsApiClient PaymentsApiClient

<div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50">
    <div class="w-full max-w-md rounded-2xl bg-white p-8 shadow-xl">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold text-slate-900">Make Payment</h2>
            <button class="text-slate-400 hover:text-slate-600" @onclick="OnClose">✕</button>
        </div>

        <div class="space-y-4 mb-6">
            <div class="rounded-xl border border-slate-200 p-4">
                <div class="text-xs font-semibold text-slate-500">Installment #@Installment.InstallmentNumber</div>
                <div class="mt-1 text-sm text-slate-700">Due: @Installment.DueDate.ToString("dd MMM yyyy")</div>
            </div>

            <div class="rounded-xl border border-slate-200 p-4">
                <div class="text-xs font-semibold text-slate-500">Amount Due</div>
                <div class="mt-1 text-lg font-bold text-slate-900">£@_remainingAmount.ToString("N2")</div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="mb-4 rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-700">
                @_error
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_success))
        {
            <div class="mb-4 rounded-xl border border-green-200 bg-green-50 p-3 text-sm text-green-700">
                @_success
            </div>
        }

        <div class="mb-4">
            <label class="block text-sm font-medium text-slate-700 mb-1">Payment Amount (£)</label>
            <input type="number" step="0.01" @bind="_paymentAmount"
                   class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        </div>

        <div class="flex justify-between gap-3">
            <button class="rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
                    @onclick="PayFullAmount">
                Pay Full Amount
            </button>
            <div class="flex gap-2">
                <button class="rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
                        @onclick="OnClose">
                    Cancel
                </button>
                <button class="rounded-xl bg-green-600 px-4 py-2 text-sm font-semibold text-white hover:bg-green-700"
                        @onclick="SubmitPayment"
                        disabled="@_isProcessing">
                    Pay
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public InstallmentDto Installment { get; set; } = default!;
    [Parameter] public Guid ScheduleId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnPaymentRecorded { get; set; }

    private decimal _paymentAmount;
    private decimal _remainingAmount;
    private bool _isProcessing;
    private string? _error;
    private string? _success;

    protected override void OnInitialized()
    {
        _remainingAmount = Installment.TotalAmount + Installment.LateFeeAmount - Installment.PaidAmount;
        _paymentAmount = _remainingAmount;
    }

    private void PayFullAmount()
    {
        _paymentAmount = _remainingAmount;
    }

    private async Task SubmitPayment()
    {
        _error = null;
        _success = null;

        if (_paymentAmount <= 0)
        {
            _error = "Payment amount must be greater than zero.";
            return;
        }

        if (_paymentAmount > _remainingAmount)
        {
            _error = $"Payment cannot exceed £{_remainingAmount:N2}.";
            return;
        }

        _isProcessing = true;
        try
        {
            var response = await PaymentsApiClient.RecordPaymentAsync(
                ScheduleId, _paymentAmount, DateTime.UtcNow);

            if (response?.Success == true)
            {
                _success = $"Payment of £{_paymentAmount:N2} recorded successfully.";
                await Task.Delay(1000);
                await OnPaymentRecorded.InvokeAsync();
            }
            else
            {
                _error = response?.Errors.FirstOrDefault() ?? "Payment failed.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isProcessing = false;
        }
    }
}
