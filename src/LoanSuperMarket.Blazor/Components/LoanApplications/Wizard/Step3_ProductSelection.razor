@namespace LoanSuperMarket.Blazor.Components.LoanApplications.Wizard
@using LoanSuperMarket.Blazor.Services
@using LoanSuperMarket.Blazor.Services.ApiClients
@using LoanSuperMarket.Shared.LoanApplications
@inject WizardStateService WizardState
@inject WizardApiClient WizardApi

<div class="space-y-6">
    <h2 class="text-lg font-semibold text-slate-800">Select a Product</h2>
    <p class="text-sm text-slate-500">Choose the loan product that best fits your needs.</p>

    @if (_isLoading)
    {
        <div class="flex items-center justify-center py-12">
            <div class="text-sm text-slate-500">Loading products...</div>
        </div>
    }
    else if (_products is not null && _products.Count > 0)
    {
        <div class="grid gap-3">
            @foreach (var product in _products)
            {
                var isSelected = _selectedProductId == product.ProductId;
                <button @onclick="() => SelectProduct(product.ProductId)"
                        class="w-full text-left rounded-xl border-2 p-5 transition
                            @(isSelected ? "border-blue-600 bg-blue-50 shadow-sm" : "border-slate-200 hover:border-blue-300")">
                    <div class="flex items-start justify-between">
                        <div class="flex items-start gap-3">
                            <div class="mt-0.5 w-5 h-5 rounded-full border-2 flex items-center justify-center
                                @(isSelected ? "border-blue-600" : "border-slate-300")">
                                @if (isSelected)
                                {
                                    <div class="w-2.5 h-2.5 rounded-full bg-blue-600"></div>
                                }
                            </div>
                            <div>
                                <h3 class="text-sm font-semibold text-slate-800">@product.Title</h3>
                                <p class="text-xs text-slate-500 mt-0.5">@product.LenderName</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-lg font-bold @(isSelected ? "text-blue-700" : "text-blue-600")">@product.EffectiveInterestRate.ToString("F2")%</div>
                            <div class="text-xs text-slate-400">effective rate</div>
                        </div>
                    </div>
                    <div class="mt-3 ml-8 flex gap-4 text-xs text-slate-500">
                        <span>Amount: @product.MinimumAmount.ToString("N0") – @product.MaximumAmount.ToString("N0")</span>
                        <span>Term: @product.MinimumTermMonths – @product.MaximumTermMonths months</span>
                    </div>
                </button>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_validationError))
    {
        <div class="rounded-lg bg-red-50 border border-red-200 p-3 text-sm text-red-700">
            @_validationError
        </div>
    }

    @if (!string.IsNullOrEmpty(_serverError))
    {
        <div class="rounded-lg bg-red-50 border border-red-200 p-3 text-sm text-red-700">
            @_serverError
        </div>
    }

    <div class="flex justify-between pt-4">
        <button @onclick="HandleBack"
                class="rounded-lg border border-slate-300 px-6 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition">
            ← Back
        </button>
        <button @onclick="HandleNextAsync"
                disabled="@_isSaving"
                class="rounded-lg bg-blue-600 px-6 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed transition">
            @if (_isSaving)
            {
                <span>Saving...</span>
            }
            else
            {
                <span>Next →</span>
            }
        </button>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private IReadOnlyList<MatchedProductDto>? _products;
    private Guid? _selectedProductId;
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _validationError;
    private string? _serverError;

    protected override async Task OnInitializedAsync()
    {
        if (!WizardState.ApplicationId.HasValue)
            return;

        try
        {
            var result = await WizardApi.MatchProductsAsync(WizardState.ApplicationId.Value);
            if (result is not null && result.Success)
            {
                _products = result.Data;
            }
        }
        catch
        {
            // Products already loaded in step 2, this is a fallback
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SelectProduct(Guid productId)
    {
        _selectedProductId = productId;
        _validationError = null;
    }

    private async Task HandleNextAsync()
    {
        _validationError = null;
        _serverError = null;

        if (!_selectedProductId.HasValue)
        {
            _validationError = "Please select a product before continuing.";
            return;
        }

        if (!WizardState.ApplicationId.HasValue)
        {
            _serverError = "Application not found.";
            return;
        }

        _isSaving = true;

        try
        {
            var request = new SelectProductRequest { LoanProductId = _selectedProductId.Value };
            var result = await WizardApi.SelectProductAsync(WizardState.ApplicationId.Value, request);

            if (result is not null && !result.Success)
            {
                _serverError = result.Errors.FirstOrDefault() ?? "Failed to select product.";
                return;
            }

            await OnNext.InvokeAsync();
        }
        catch (Exception ex)
        {
            _serverError = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task HandleBack()
    {
        await OnBack.InvokeAsync();
    }
}
