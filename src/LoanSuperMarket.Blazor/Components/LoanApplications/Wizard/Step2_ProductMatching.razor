@namespace LoanSuperMarket.Blazor.Components.LoanApplications.Wizard
@using LoanSuperMarket.Blazor.Services
@using LoanSuperMarket.Blazor.Services.ApiClients
@using LoanSuperMarket.Shared.LoanApplications
@inject WizardStateService WizardState
@inject WizardApiClient WizardApi

<div class="space-y-6">
    <h2 class="text-lg font-semibold text-slate-800">Product Matching</h2>
    <p class="text-sm text-slate-500">Based on your loan parameters, here are the products available to you.</p>

    @if (_isLoading)
    {
        <div class="flex items-center justify-center py-12">
            <div class="text-sm text-slate-500">Finding matching products...</div>
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="rounded-lg bg-red-50 border border-red-200 p-4 text-sm text-red-700">
            @_error
        </div>
    }
    else if (_products is null || _products.Count == 0)
    {
        <div class="rounded-lg bg-amber-50 border border-amber-200 p-6 text-center">
            <p class="text-sm font-medium text-amber-800">No matching products found.</p>
            <p class="text-xs text-amber-600 mt-1">Try adjusting your requested amount or term in the previous step.</p>
        </div>
    }
    else
    {
        <div class="grid gap-4">
            @foreach (var product in _products)
            {
                <div class="rounded-xl border border-slate-200 p-5 hover:border-blue-300 hover:shadow-sm transition">
                    <div class="flex items-start justify-between">
                        <div>
                            <h3 class="text-sm font-semibold text-slate-800">@product.Title</h3>
                            <p class="text-xs text-slate-500 mt-0.5">@product.LenderName</p>
                        </div>
                        <div class="text-right">
                            <div class="text-lg font-bold text-blue-600">@product.EffectiveInterestRate.ToString("F2")%</div>
                            <div class="text-xs text-slate-400">effective rate</div>
                        </div>
                    </div>
                    <div class="mt-3 flex gap-4 text-xs text-slate-500">
                        <span>Amount: @product.MinimumAmount.ToString("N0") – @product.MaximumAmount.ToString("N0")</span>
                        <span>Term: @product.MinimumTermMonths – @product.MaximumTermMonths months</span>
                    </div>
                </div>
            }
        </div>
    }

    <div class="flex justify-between pt-4">
        <button @onclick="HandleBack"
                class="rounded-lg border border-slate-300 px-6 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition">
            ← Back
        </button>
        <button @onclick="HandleNext"
                disabled="@(_products is null || _products.Count == 0)"
                class="rounded-lg bg-blue-600 px-6 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed transition">
            Next →
        </button>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private IReadOnlyList<MatchedProductDto>? _products;
    private bool _isLoading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        if (!WizardState.ApplicationId.HasValue)
        {
            _error = "Application not found. Please go back and start again.";
            _isLoading = false;
            return;
        }

        try
        {
            var result = await WizardApi.MatchProductsAsync(WizardState.ApplicationId.Value);
            if (result is not null && result.Success)
            {
                _products = result.Data;
            }
            else
            {
                _error = result?.Errors.FirstOrDefault() ?? "Failed to match products.";
            }
        }
        catch (Exception ex)
        {
            _error = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleNext()
    {
        await OnNext.InvokeAsync();
    }

    private async Task HandleBack()
    {
        await OnBack.InvokeAsync();
    }
}
