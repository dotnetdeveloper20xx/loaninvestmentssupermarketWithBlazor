@* SVG-based sparkline mini chart *@

@if (Data.Count > 1)
{
    <svg width="@Width" height="@Height" class="inline-block" viewBox="0 0 @Width @Height">
        <polyline fill="none"
                  stroke="@StrokeColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  points="@GetPoints()" />
    </svg>
}

@code {
    [Parameter] public List<decimal> Data { get; set; } = [];
    [Parameter] public int Width { get; set; } = 80;
    [Parameter] public int Height { get; set; } = 24;
    [Parameter] public string StrokeColor { get; set; } = "#3b82f6";

    private string GetPoints()
    {
        if (Data.Count < 2) return "";

        var max = Data.Max();
        var min = Data.Min();
        var range = max - min;
        if (range == 0) range = 1;

        var padding = 2;
        var usableWidth = Width - (padding * 2);
        var usableHeight = Height - (padding * 2);
        var stepX = (decimal)usableWidth / (Data.Count - 1);

        var points = new List<string>();
        for (var i = 0; i < Data.Count; i++)
        {
            var x = padding + (stepX * i);
            var normalized = (Data[i] - min) / range;
            var y = padding + usableHeight - (normalized * usableHeight);
            points.Add($"{x:F1},{y:F1}");
        }

        return string.Join(" ", points);
    }
}
