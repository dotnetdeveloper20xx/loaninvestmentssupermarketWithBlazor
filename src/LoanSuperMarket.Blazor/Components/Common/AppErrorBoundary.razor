@inherits ErrorBoundary

@if (CurrentException is not null)
{
    <div class="rounded-2xl border border-red-200 bg-red-50 p-8 text-center">
        <div class="text-4xl mb-4">⚠️</div>
        <h3 class="text-lg font-semibold text-red-800 mb-2">Something went wrong</h3>
        <p class="text-sm text-red-600 mb-4">
            An unexpected error occurred. Please try refreshing the page.
        </p>
        <details class="text-left text-xs text-red-500 bg-red-100 rounded-lg p-3 mb-4">
            <summary class="cursor-pointer font-medium">Technical Details</summary>
            <pre class="mt-2 whitespace-pre-wrap">@CurrentException.Message</pre>
        </details>
        <button class="rounded-xl bg-red-600 px-6 py-2.5 text-sm font-semibold text-white hover:bg-red-700"
                @onclick="Recover">
            Try Again
        </button>
    </div>
}
else
{
    @ChildContent
}
