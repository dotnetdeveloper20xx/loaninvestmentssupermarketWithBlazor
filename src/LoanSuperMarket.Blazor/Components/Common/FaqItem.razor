@* Collapsible FAQ accordion item *@

<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
    <button class="w-full px-6 py-4 text-left flex items-center justify-between hover:bg-slate-50 transition"
            @onclick="Toggle">
        <span class="text-sm font-semibold text-slate-900">@Question</span>
        <span class="text-slate-400 text-lg transition-transform @(_isOpen ? "rotate-180" : "")">▼</span>
    </button>
    @if (_isOpen)
    {
        <div class="px-6 pb-4 text-sm text-slate-600 border-t border-slate-100 pt-3">
            @Answer
        </div>
    }
</div>

@code {
    [Parameter] public string Question { get; set; } = string.Empty;
    [Parameter] public string Answer { get; set; } = string.Empty;

    private bool _isOpen;

    private void Toggle() => _isOpen = !_isOpen;
}
