@* Simple CSS-only bar chart for dashboards *@

<div>
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <h4 class="text-sm font-semibold text-slate-700 mb-3">@Title</h4>
    }

    <div class="flex items-end gap-1 h-40">
        @if (Data.Count > 0)
        {
            var maxValue = Data.Max(d => d.Value);
            @foreach (var item in Data)
            {
                var heightPercent = maxValue > 0 ? (item.Value / maxValue * 100) : 0;
                <div class="flex-1 flex flex-col items-center justify-end h-full">
                    <div class="w-full rounded-t-md @(item.Color ?? "bg-blue-500") transition-all duration-500 min-h-[2px]"
                         style="height: @heightPercent%"
                         title="@item.Label: @item.Value.ToString("N0")">
                    </div>
                </div>
            }
        }
    </div>

    @if (ShowLabels && Data.Count > 0)
    {
        <div class="flex gap-1 mt-2">
            @foreach (var item in Data)
            {
                <div class="flex-1 text-center">
                    <div class="text-xs text-slate-400 truncate">@item.Label</div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public List<BarChartItem> Data { get; set; } = [];
    [Parameter] public bool ShowLabels { get; set; } = true;
}
