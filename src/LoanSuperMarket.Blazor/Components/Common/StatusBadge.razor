<span class="@BadgeClass">
    @DisplayText
</span>

@code {
    [Parameter]
    public string Status { get; set; } = string.Empty;

    private string DisplayText => Status switch
    {
        "PendingApproval" => "Pending Approval",
        _ => Status
    };

    private string BadgeClass => Status switch
    {
        "Draft" => "inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700",
        "PendingApproval" => "inline-flex rounded-full bg-orange-100 px-3 py-1 text-xs font-semibold text-orange-700",
        "Approved" => "inline-flex rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-700",
        "Published" => "inline-flex rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700",
        "Archived" => "inline-flex rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-700",

        "Submitted" => "inline-flex rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-700",
        "Rejected" => "inline-flex rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-700",
        "Funded" => "inline-flex rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700",
        "Completed" => "inline-flex rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700",
        "Overdue" => "inline-flex rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-700",
        "Failed" => "inline-flex rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-700",

        _ => "inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700"
    };
}