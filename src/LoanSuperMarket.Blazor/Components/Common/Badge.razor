@* Reusable badge/pill component with color variants *@

<span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold @GetClasses()">
    @Text
</span>

@code {
    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public string Color { get; set; } = "slate"; // green, red, amber, blue, purple, slate

    private string GetClasses() => Color switch
    {
        "green" => "bg-green-100 text-green-800",
        "red" => "bg-red-100 text-red-800",
        "amber" => "bg-amber-100 text-amber-800",
        "blue" => "bg-blue-100 text-blue-800",
        "purple" => "bg-purple-100 text-purple-800",
        "emerald" => "bg-emerald-100 text-emerald-800",
        _ => "bg-slate-100 text-slate-700"
    };
}
