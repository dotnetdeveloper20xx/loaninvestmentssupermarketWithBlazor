@* Interactive loan calculator — shows EMI, total interest, total repayment *@

<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="text-lg font-semibold text-slate-900 mb-4">💡 Loan Calculator</h3>

    <div class="grid gap-4 md:grid-cols-3 mb-6">
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Loan Amount (£)</label>
            <input type="number" step="100" @bind="_amount" @bind:event="oninput" @bind:after="Calculate"
                   class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        </div>
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Annual Rate (%)</label>
            <input type="number" step="0.1" @bind="_rate" @bind:event="oninput" @bind:after="Calculate"
                   class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        </div>
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Term (months)</label>
            <input type="number" @bind="_term" @bind:event="oninput" @bind:after="Calculate"
                   class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        </div>
    </div>

    @if (_emi > 0)
    {
        <div class="grid gap-4 md:grid-cols-3">
            <div class="rounded-xl bg-blue-50 border border-blue-200 p-4 text-center">
                <div class="text-xs font-semibold text-blue-600 uppercase">Monthly Payment</div>
                <div class="mt-1 text-xl font-bold text-blue-800">£@_emi.ToString("N2")</div>
            </div>
            <div class="rounded-xl bg-amber-50 border border-amber-200 p-4 text-center">
                <div class="text-xs font-semibold text-amber-600 uppercase">Total Interest</div>
                <div class="mt-1 text-xl font-bold text-amber-800">£@_totalInterest.ToString("N2")</div>
            </div>
            <div class="rounded-xl bg-green-50 border border-green-200 p-4 text-center">
                <div class="text-xs font-semibold text-green-600 uppercase">Total Repayment</div>
                <div class="mt-1 text-xl font-bold text-green-800">£@_totalRepayment.ToString("N2")</div>
            </div>
        </div>
    }
</div>

@code {
    private decimal _amount = 10000;
    private decimal _rate = 12;
    private int _term = 24;
    private decimal _emi;
    private decimal _totalInterest;
    private decimal _totalRepayment;

    protected override void OnInitialized()
    {
        Calculate();
    }

    private void Calculate()
    {
        if (_amount <= 0 || _rate <= 0 || _term <= 0)
        {
            _emi = 0;
            _totalInterest = 0;
            _totalRepayment = 0;
            return;
        }

        var monthlyRate = _rate / 12m / 100m;
        var compoundFactor = (decimal)Math.Pow((double)(1m + monthlyRate), _term);
        _emi = Math.Round(_amount * monthlyRate * compoundFactor / (compoundFactor - 1m), 2);
        _totalRepayment = _emi * _term;
        _totalInterest = _totalRepayment - _amount;
    }
}
